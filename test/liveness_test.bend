import Base
import ./check.bend as C
import ../src/core/liveness.bend as L

def main() -> IO(Unit):
  do IO<Unit>:
    +start : L.Live = L.Live{100n, 0n, False{}, False{}, "shell: uncook"}
    +early : L.Decision = L.Liveness.tick(True{}, 1299n, 1200n, 60n, start)
    C.Check.str("no nudge before the gap", Bool.show(L.Decision.nudge(early)), "False")
    C.Check.str("no stall before the gap", Bool.show(L.Liveness.stalled(L.Decision.live(early))), "False")
    +nudge : L.Decision = L.Liveness.tick(True{}, 1300n, 1200n, 60n, start)
    C.Check.str("nudge at the exact threshold", Bool.show(L.Decision.nudge(nudge)), "True")
    C.Check.str("nudge precedes stall", Bool.show(L.Liveness.stalled(L.Decision.live(nudge))), "False")
    C.Check.str("nudge records its time", Nat.show(L.Liveness.nudged(L.Decision.live(nudge))), "1300")
    +grace : L.Decision = L.Liveness.tick(True{}, 1359n, 1200n, 60n, L.Decision.live(nudge))
    C.Check.str("no second nudge while waiting", Bool.show(L.Decision.nudge(grace)), "False")
    C.Check.str("grace is respected", Bool.show(L.Liveness.stalled(L.Decision.live(grace))), "False")
    +stalled : L.Decision = L.Liveness.tick(True{}, 1360n, 1200n, 60n, L.Decision.live(grace))
    C.Check.str("stall after nudge grace", Bool.show(L.Liveness.stalled(L.Decision.live(stalled))), "True")
    C.Check.str("launcher notified on escalation", Bool.show(L.Decision.notify(stalled)), "True")
    C.Check.str("reason survives escalation", L.Liveness.reason(L.Decision.live(stalled)), "shell: uncook")
    +again : L.Decision = L.Liveness.tick(True{}, 1900n, 1200n, 60n, L.Decision.live(stalled))
    C.Check.str("no repeated launcher notification", Bool.show(L.Decision.notify(again)), "False")
    C.Check.str("no repeated nudge while stalled", Bool.show(L.Decision.nudge(again)), "False")
    C.Check.str("stalled work is never killed", Bool.show(L.Decision.kills(again)), "False")
    +progress : L.Live = L.Liveness.progress(L.Decision.live(stalled), 2000n, "work output grew")
    C.Check.str("real progress clears stall", Bool.show(L.Liveness.stalled(progress)), "False")
    C.Check.str("real progress clears old nudge", Nat.show(L.Liveness.nudged(progress)), "0")
    C.Check.str("real progress clears old launcher notification", Bool.show(L.Liveness.reported(progress)), "False")
    C.Check.str("progress records its evidence", L.Liveness.reason(progress), "work output grew")
    C.Check.str("fresh gap can nudge again", Bool.show(L.Decision.nudge(L.Liveness.tick(True{}, 3200n, 1200n, 60n, progress))), "True")
    C.Check.str("idle thread is never nudged", Bool.show(L.Decision.nudge(L.Liveness.tick(False{}, 9999n, 1200n, 60n, start))), "False")
    C.Check.str("idle clears previous stall", Bool.show(L.Liveness.stalled(L.Decision.live(L.Liveness.tick(False{}, 9999n, 1200n, 60n, L.Decision.live(stalled))))), "False")
    C.Check.str("zero gap disables watchdog", Bool.show(L.Decision.nudge(L.Liveness.tick(True{}, 9999n, 0n, 60n, start))), "False")
    C.Check.str("backward clock causes no false stall", Bool.show(L.Decision.nudge(L.Liveness.tick(True{}, 50n, 1200n, 60n, start))), "False")
    +clock : L.Decision = L.Liveness.tick(True{}, 1200n, 1200n, 60n, L.Decision.live(nudge))
    C.Check.str("clock adjustment retains episode marker", Nat.show(L.Liveness.nudged(L.Decision.live(clock))), "1300")
    C.Check.str("clock catching up causes no duplicate nudge", Bool.show(L.Decision.nudge(L.Liveness.tick(True{}, 1400n, 1200n, 60n, L.Decision.live(clock)))), "False")
    C.Check.str("backward progress cannot reduce last", Nat.show(L.Liveness.last(L.Liveness.progress(progress, 50n, "file write"))), "2000")
    C.Check.str("state survives JSON replay", L.Liveness.write(L.Liveness.read(L.Liveness.write(L.Decision.live(stalled)))), L.Liveness.write(L.Decision.live(stalled)))
    C.Check.str("missing state starts unstalled", Bool.show(L.Liveness.stalled(L.Liveness.read(""))), "False")
    C.Check.str("numeric setting", Nat.show(L.Liveness.number("1200", 42n)), "1200")
    C.Check.str("invalid setting falls back", Nat.show(L.Liveness.number("1oops", 42n)), "42")
    C.Check.str("missing timeout defaults to twenty minutes", Nat.show(L.Liveness.timeout(False{}, 0n)), "1200")
    C.Check.str("explicit zero timeout opts out", Nat.show(L.Liveness.timeout(True{}, 0n)), "0")
    C.Check.str("explicit timeout is retained", Nat.show(L.Liveness.timeout(True{}, 3600n)), "3600")
