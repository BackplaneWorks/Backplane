(kicad_pcb (version 20250101) (general (thickness 1.6))
 (gr_rect (start 10 10) (end 60 60) (stroke (width 0.1)) (layer "Edge.Cuts") (uuid "edge"))
 (footprint "Test:Front" (layer "F.Cu") (uuid "front") (at 20 30 90)
  (property "Reference" "F1" (at 2 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.1))))
  (fp_line (start 0 0) (end 3 0) (stroke (width 0.2)) (layer "F.SilkS") (uuid "line"))
  (pad "1" thru_hole rect (at 2 0 90) (size 4 2) (drill 1) (layers "*.Cu" "*.Mask") (uuid "pad"))
  (model "${KICAD10_3DMODEL_DIR}/test.step" (offset (xyz 1 2 3)) (scale (xyz 2 3 4)) (rotate (xyz 0 0 0))))
 (footprint "Test:Back" (layer "B.Cu") (uuid "back") (at 50 40 -90)
  (pad "1" smd oval (at 0 2 -90) (size 4 2) (layers "B.Cu") (uuid "pad"))
  (fp_circle (center 0 0) (end 1 0) (stroke (width 0.2)) (fill none) (layer "B.SilkS") (uuid "circle"))
  (model "back.step" (offset (xyz 1 2 3)) (scale (xyz 2 3 4)) (rotate (xyz 0 0 0))))
)
