{
  "_": "The phones' list of paired hubs and the addresses an invitation is tried at. Android's HubListTest and iOS's Tests/HubListTests.swift (scripts/mobile/ios-hub-list-test.sh) read this table. A hub's key is its host:port; the first link is the hub in use.",
  "adopt": [
    {"name": "the first hub", "links": [], "link": "http://a:1/#token=0123456789abcdef0123456789abcdef", "want": ["http://a:1/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "a second hub goes first and keeps the first", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "link": "https://b.ts.net:8451/#token=0123456789abcdef0123456789abcdef", "want": ["https://b.ts.net:8451/#token=0123456789abcdef0123456789abcdef", "http://a:1/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "re-pairing a hub replaces its old credential", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "http://b:2/#token=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "link": "http://b:2/#token=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "want": ["http://b:2/#token=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "http://a:1/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "another port is another hub", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "link": "http://a:2/#token=0123456789abcdef0123456789abcdef", "want": ["http://a:2/#token=0123456789abcdef0123456789abcdef", "http://a:1/#token=0123456789abcdef0123456789abcdef"]}
  ],
  "use": [
    {"name": "switching moves that hub first", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "http://b:2/#token=0123456789abcdef0123456789abcdef", "http://c:3/#token=0123456789abcdef0123456789abcdef"], "key": "c:3", "want": ["http://c:3/#token=0123456789abcdef0123456789abcdef", "http://a:1/#token=0123456789abcdef0123456789abcdef", "http://b:2/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "an unknown hub changes nothing", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "key": "z:9", "want": ["http://a:1/#token=0123456789abcdef0123456789abcdef"]}
  ],
  "forget": [
    {"name": "forgetting the hub in use falls back to the next", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "http://b:2/#token=0123456789abcdef0123456789abcdef"], "key": "a:1", "want": ["http://b:2/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "forgetting another keeps the one in use", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "http://b:2/#token=0123456789abcdef0123456789abcdef"], "key": "b:2", "want": ["http://a:1/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "forgetting the last leaves none", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "key": "a:1", "want": []}
  ],
  "routes": [
    {"name": "the link's own address first, then the others it names", "text": "https://m.tail.ts.net:8451/pair#invite=0123456789abcdef0123456789abcdef&routes=%5B%22https%3A%2F%2Fm.tail.ts.net%3A8451%22%2C%22http%3A%2F%2F100.64.84.41%3A3797%22%5D", "want": ["https://m.tail.ts.net:8451", "http://100.64.84.41:3797"], "local": false},
    {"name": "no routes field: the link's address alone", "text": "http://100.1.2.3:3801/pair#code=ABCD2345", "want": ["http://100.1.2.3:3801"], "local": false},
    {"name": "addresses that are not plain http(s) origins are dropped", "text": "http://100.1.2.3:3801/pair#invite=0123456789abcdef0123456789abcdef&routes=%5B%22javascript%3Aalert(1)%22%2C%22http%3A%2F%2Fu%3Ap%40evil%3A1%22%2C%22ftp%3A%2F%2Fx%22%2C%22http%3A%2F%2F192.168.1.5%3A3801%2Fpath%3Fq%22%5D", "want": ["http://100.1.2.3:3801", "http://192.168.1.5:3801"], "local": false},
    {"name": "a link that names only the hub's own computer", "text": "http://127.0.0.1:3797/pair#invite=0123456789abcdef0123456789abcdef&routes=%5B%22http%3A%2F%2F127.0.0.1%3A3797%22%5D", "want": ["http://127.0.0.1:3797"], "local": true},
    {"name": "localhost and ::1 are the hub's own computer too", "text": "http://localhost:3797/pair#invite=0123456789abcdef0123456789abcdef&routes=%5B%22http%3A%2F%2F%5B%3A%3A1%5D%3A3797%22%5D", "want": ["http://localhost:3797", "http://[::1]:3797"], "local": true},
    {"name": "a routes field that is not JSON is ignored", "text": "http://100.1.2.3:3801/pair#invite=0123456789abcdef0123456789abcdef&routes=nope", "want": ["http://100.1.2.3:3801"], "local": false}
  ],
  "added": [
    {"name": "an offered hub goes second: the one in use stays in use", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "http://c:3/#token=0123456789abcdef0123456789abcdef"], "link": "https://boat-hub.tail9e0cf2.ts.net/#token=0123456789abcdef0123456789abcdef", "want": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "https://boat-hub.tail9e0cf2.ts.net/#token=0123456789abcdef0123456789abcdef", "http://c:3/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "an older pairing with it is replaced", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "http://c:3/#token=0123456789abcdef0123456789abcdef", "https://boat-hub.tail9e0cf2.ts.net/#token=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"], "link": "https://boat-hub.tail9e0cf2.ts.net/#token=0123456789abcdef0123456789abcdef", "want": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "https://boat-hub.tail9e0cf2.ts.net/#token=0123456789abcdef0123456789abcdef", "http://c:3/#token=0123456789abcdef0123456789abcdef"]},
    {"name": "with no hub it is the first", "links": [], "link": "https://boat-hub.tail9e0cf2.ts.net/#token=0123456789abcdef0123456789abcdef", "want": ["https://boat-hub.tail9e0cf2.ts.net/#token=0123456789abcdef0123456789abcdef"]}
  ],
  "_offer": "An offer from the hub in use (info hub.offer, docs/pairing.md, Home hub): token is the device token this client holds for the hub in use (\"\" for none, as the desktop on its own hub's token). plan none: nothing to do; known: the hub is already on the list (no take, it becomes the home when why is home); same: add link as it is (the same token at the offered url); take: ask hub.offer.take for a pairing link and redeem it. done lists offers already answered.",
  "offer": [
    {"name": "a phone with its own token adds the hub with that token", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"https://boat-hub.tail9e0cf2.ts.net\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "same", "key": "boat-hub.tail9e0cf2.ts.net", "link": "https://boat-hub.tail9e0cf2.ts.net/#token=0123456789abcdef0123456789abcdef"}},
    {"name": "an offer's url with a path or slash keeps only its origin", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"https://boat-hub.tail9e0cf2.ts.net:8451/x/\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "same", "key": "boat-hub.tail9e0cf2.ts.net:8451", "link": "https://boat-hub.tail9e0cf2.ts.net:8451/#token=0123456789abcdef0123456789abcdef"}},
    {"name": "no token of its own takes a link", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"https://boat-hub.tail9e0cf2.ts.net\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1"], "token": "", "done": [], "want": {"plan": "take", "key": "boat-hub.tail9e0cf2.ts.net", "link": ""}},
    {"name": "no credential field takes a link", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"https://boat-hub.tail9e0cf2.ts.net\", \"why\": \"home\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "take", "key": "boat-hub.tail9e0cf2.ts.net", "link": ""}},
    {"name": "already paired means no take", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"https://boat-hub.tail9e0cf2.ts.net\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef", "https://boat-hub.tail9e0cf2.ts.net/#token=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "known", "key": "boat-hub.tail9e0cf2.ts.net", "link": ""}},
    {"name": "an offer for the hub in use is nothing", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"http://a:1\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "none", "key": "", "link": ""}},
    {"name": "an answered offer is not taken again", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"https://boat-hub.tail9e0cf2.ts.net\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": ["o1"], "want": {"plan": "none", "key": "", "link": ""}},
    {"name": "no offer", "offer": "", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "none", "key": "", "link": ""}},
    {"name": "an offer that is not JSON", "offer": "{nope", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "none", "key": "", "link": ""}},
    {"name": "an offer without an id", "offer": "{\"id\": \"\", \"name\": \"boat-hub\", \"url\": \"https://boat-hub.tail9e0cf2.ts.net\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "none", "key": "", "link": ""}},
    {"name": "an offer whose url is not http(s)", "offer": "{\"id\": \"o1\", \"name\": \"boat-hub\", \"url\": \"javascript:alert(1)\", \"why\": \"home\", \"credential\": \"same\"}", "links": ["http://a:1/#token=0123456789abcdef0123456789abcdef"], "token": "0123456789abcdef0123456789abcdef", "done": [], "want": {"plan": "none", "key": "", "link": ""}}
  ],
  "_failover": "Home failover: main is the hub in use (first on the list), home the hub remembered as the home (\"\" for none). down is how long main has not answered, in seconds; onHome whether the client is on the home now. want: whether to be on the home.",
  "failover": [
    {"name": "main down 20 s and the home answers: the home", "main": "a:1", "home": "boat:443", "onHome": false, "down": 20, "homeUp": true, "mainUp": false, "want": true},
    {"name": "main down a short while: stay", "main": "a:1", "home": "boat:443", "onHome": false, "down": 19, "homeUp": true, "mainUp": false, "want": false},
    {"name": "the home does not answer: stay", "main": "a:1", "home": "boat:443", "onHome": false, "down": 60, "homeUp": false, "mainUp": false, "want": false},
    {"name": "no home: stay", "main": "a:1", "home": "", "onHome": false, "down": 60, "homeUp": true, "mainUp": false, "want": false},
    {"name": "the home is the hub in use: stay", "main": "a:1", "home": "a:1", "onHome": false, "down": 60, "homeUp": true, "mainUp": false, "want": false},
    {"name": "on the home, main still down: stay on the home", "main": "a:1", "home": "boat:443", "onHome": true, "down": 90, "homeUp": true, "mainUp": false, "want": true},
    {"name": "on the home, main answers: back", "main": "a:1", "home": "boat:443", "onHome": true, "down": 90, "homeUp": true, "mainUp": true, "want": false},
    {"name": "on the home, it drops too: stay until main answers", "main": "a:1", "home": "boat:443", "onHome": true, "down": 90, "homeUp": false, "mainUp": false, "want": true}
  ]
}
