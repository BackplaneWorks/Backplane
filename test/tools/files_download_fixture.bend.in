# Bounded HTTP fixture calling byte-verified production FilesHttp handlers.
# It substitutes only the hub actor's root lookup, never path or auth policy.
import Base
import ./t/src/server/server.bend as S
import ./t/src/server/host.bend as H
import ./t/src/core/hub.bend as B
import ./t/src/core/http.bend as W

def Actor.one(m: Maybe<&1, S.Msg>, +root: String, +home: String) -> IO(Unit):
  match m:
    case Some{S.FilesRoot{+thread, +reply}}:
      do IO<Unit>:
        sent : Result<&1, &1, S.FilesLocation, Unit> <- Chan.send(S.FilesLocation, reply,
          S.FilesLocation{B.FilesAt{Bool.pick(String, String.eq(thread, "t"), root, ""), "Fixture"}, home})
        return Unit{}
    case _: IO.pure(Unit, Unit{})

def Actor.loop(fuel: Nat, +root: String, +home: String, +inbox: Chan(S.Msg)) -> IO(Unit):
  match fuel:
    case 0n: IO.pure(Unit, Unit{})
    case 1n+n:
      do IO<Unit>:
        got : Maybe<&1, S.Msg> <- Chan.recv(S.Msg, inbox)
        Actor.one(got, root, home)
        Actor.loop(n, root, home, inbox)

def Request.go(req: W.Request, s: Socket, +inbox: Chan(S.Msg)) -> IO(Unit):
  match req:
    case W.Request{_, +path, +headers}:
      S.FilesHttp.serve(S.Conn.allowed(headers, path, "paired-fixture"), String.eq(W.Http.route(path), "/files/zip"), s, path, W.Http.header_of(headers, "range"), inbox)

def Request.read(r: Socket & Result<&1, &1, U32 & String, List<&2, U32>>, +inbox: Chan(S.Msg)) -> IO(Unit):
  (s, got) = r
  match got:
    case Done{bytes}: Request.go(W.Http.request(bytes), s, inbox)
    case Fail{_}: Socket.close(s)

def Accept.one(r: Listener & Result<&1, &1, U32 & String, Socket>, +inbox: Chan(S.Msg)) -> IO(Listener):
  (listener, got) = r
  match got:
    case Done{s}:
      do IO<Listener>:
        IO.spawn(Unit, IO.bind(Socket & Result<&1, &1, U32 & String, List<&2, U32>>, Unit, H.Sock.recv_bytes(s, 65536), r => Request.read(r, inbox)))
        return listener
    case Fail{_}: IO.pure(Listener, listener)

def Accept.loop(fuel: Nat, listener: Listener, +inbox: Chan(S.Msg)) -> IO(Unit):
  match fuel:
    case 0n: Listener.close(listener)
    case 1n+n:
      do IO<Unit>:
        got : Listener & Result<&1, &1, U32 & String, Socket> <- TCP.accept(listener)
        next : Listener <- Accept.one(got, inbox)
        Accept.loop(n, next, inbox)

def main() -> IO(Unit):
  do IO<Unit>:
    +root : String <- S.Env.get("FILES_TEST_ROOT", "")
    +home : String <- S.Env.get("FILES_TEST_HOME", "")
    port : String <- S.Env.get("FILES_TEST_PORT", "0")
    +inbox : Chan(S.Msg) <- Chan.new(S.Msg, 32)
    IO.spawn(Unit, Actor.loop(10000n, root, home, inbox))
    listener : Listener <- IO.try(Listener, TCP.listen("127.0.0.1", Maybe.default(&2, U32, U32.read(port), 0)))
    IO.print("FILES_HTTP_READY")
    Accept.loop(10000n, listener, inbox)
