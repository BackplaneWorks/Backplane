# A disposable HTTP hub around exact, byte-verified production request planning,
# folder resolution, file handlers and Git sinks. No real event log or agents.
import Base
import ./t/src/core/model.bend as M
import ./t/src/core/hub.bend as B
import ./t/src/core/json.bend as J
import ./t/src/core/http.bend as W
import ./t/src/core/attach.bend as A
import ./t/src/core/rview.bend as RV
import ./t/src/server/server.bend as S
import ./t/src/server/host.bend as H
import ./t/src/server/git.bend as G
import ./t/src/server/farview.bend as FVS

def Fixture.state(+root: String) -> M.State:
  M.State.replay([
    M.ProjectCreated{"p", "Fixture", root, 1n},
    M.ThreadCreated{"t", "p", "Active", M.Local{}, "", "", "claude", "", 2n},
    M.ThreadCreated{"archived", "p", "Archived", M.Local{}, "", "", "claude", "", 2n}, M.ThreadArchived{"archived", True{}, 3n},
    M.ThreadCreated{"deleted", "p", "Deleted", M.Local{}, "", "", "claude", "", 2n}, M.ThreadDeleted{"deleted", 3n}], M.State.empty())

def Fixture.sent(m: Maybe<&1, S.Msg>, s: Socket) -> IO(Unit):
  match m:
    case Some{S.Push{_, text}}: S.Conn.finish(s, S.Bot.json("200 OK", text))
    case _: S.Conn.finish(s, W.Http.text("500 Internal Server Error", "no production reply"))

def Fixture.render(requested: Bool, +pin: Chan(S.Msg), +th: String, +cwd: String, +path: String) -> IO(Unit):
  match requested:
    case True{}: S.Mech.render(pin, 1, "1", th, cwd, path)
    case False{}:
      S.GitJob.reply(pin, 1, "1", True{}, J.Json.obj([J.KV{"plannedJob", J.Str{"render"}}, J.KV{"plannedRoot", J.Str{cwd}}]))

def Fixture.job.go(+job: String, +th: String, +cwd: String, +a: String, +b: String, +pin: Chan(S.Msg)) -> IO(Unit):
  match job:
    case "dir": S.DirJob.run(pin, 1, "1", th, cwd, a)
    case "files": S.Files.list(pin, 1, "1", th, cwd)
    case "mech": S.Mech.list(pin, 1, "1", th, cwd)
    case "render": Fixture.render(Bool.not(String.is_empty(a)), pin, th, cwd, a)
    case "status":
      IO.bind(String, Unit, G.Git.status(cwd), text => S.GitJob.reply(pin, 1, "1", True{}, J.Json.obj([J.KV{"status", J.Str{text}}])))
    case "diff":
      IO.bind(String, Unit, S.GitJob.diff(cwd, th, a, b), text => S.GitJob.diff.k(pin, 1, "1", th, text))
    case "revert":
      IO.bind(String, Unit, G.Git.checkpoint.revert(cwd, th, 0n), text => S.GitJob.text.k(pin, 1, "1", th, "revert", text))
    case "act":
      IO.bind(String, Unit, G.Git.act(cwd, a, b, "", ""), text => S.GitJob.text.k(pin, 1, "1", th, "act", text))
    case "checkpoint":
      IO.bind(String, Unit, G.Git.checkpoint.capture(cwd, th, 0n), text => S.GitJob.text.k(pin, 1, "1", th, "checkpoint", text))
    case _:
      S.GitJob.reply(pin, 1, "1", True{}, J.Json.obj([J.KV{"plannedJob", J.Str{job}}, J.KV{"plannedRoot", J.Str{cwd}}]))

def Fixture.job(+job: String, +th: String, +cwd: String, +a: String, +b: String, s: Socket) -> IO(Unit):
  do IO<Unit>:
    +pin : Chan(S.Msg) <- Chan.new(S.Msg, 16)
    Fixture.job.go(job, th, cwd, a, b, pin)
    m : Maybe<&1, S.Msg> <- Chan.recv(S.Msg, pin)
    Fixture.sent(m, s)

def Fixture.outs(os: List<&2, B.Out>, s: Socket) -> IO(Unit):
  match os:
    case Nil{}: S.Conn.finish(s, W.Http.text("500 Internal Server Error", "no output"))
    case B.Watch{_, _, root, path, _, _, _} <> _:
      S.Conn.finish(s, S.Bot.json("200 OK", J.Json.show(J.Json.obj([J.KV{"ok", J.Flag{True{}}}, J.KV{"plotRoot", J.Str{root}}, J.KV{"plotPath", J.Str{path}}]))))
    case B.Send{_, text} <> _: S.Conn.finish(s, S.Bot.json("200 OK", text))
    case B.Git{_, _, job, th, cwd, a, b} <> _: Fixture.job(job, th, cwd, a, b, s)
    case _ <> rest: Fixture.outs(rest, s)

def Fixture.step(step: B.Step, s: Socket) -> IO(Unit):
  match step:
    case B.Step{_, os}: Fixture.outs(os, s)

def Fixture.param(+path: String, key: String) -> String:
  A.Att.unpct(W.Http.param(path, key))

def Fixture.request(+st: M.State, +path: String, s: Socket) -> IO(Unit):
  Fixture.step(B.Hub.request(st, 10n, 1, J.Json.obj([J.KV{"id", J.Num{"1"}}, J.KV{"m", J.Str{Fixture.param(path, "method")}}, J.KV{"p", J.Json.obj([
    J.KV{"thread", J.Str{Fixture.param(path, "thread")}}, J.KV{"path", J.Str{Fixture.param(path, "path")}}, J.KV{"turn", J.Num{"0"}},
    J.KV{"kind", J.Str{Fixture.param(path, "kind")}}, J.KV{"root", J.Str{Fixture.param(path, "root")}},
    J.KV{"action", J.Str{Fixture.param(path, "action")}}, J.KV{"message", J.Str{"fixture commit"}}, J.KV{"text", J.Str{"fixture turn"}}])}])), s)

def Fixture.root.one(m: Maybe<&1, S.Msg>, +st: M.State, +home: String) -> IO(Unit):
  match m:
    case Some{S.FilesRoot{thread, +reply}}:
      do IO<Unit>:
        sent : Result<&1, &1, S.FilesLocation, Unit> <- Chan.send(S.FilesLocation, reply, S.FilesLocation{B.Hub.files.of(st, thread), home})
        return Unit{}
    case _: IO.pure(Unit, Unit{})

def Fixture.root.loop(fuel: Nat, +st: M.State, +home: String, +inbox: Chan(S.Msg)) -> IO(Unit):
  match fuel:
    case 0n: IO.pure(Unit, Unit{})
    case 1n+n:
      do IO<Unit>:
        m : Maybe<&1, S.Msg> <- Chan.recv(S.Msg, inbox)
        Fixture.root.one(m, st, home)
        Fixture.root.loop(n, st, home, inbox)

def Fixture.read(ok: Bool, +root: String, +path: String, s: Socket) -> IO(Unit):
  match ok:
    case False{}: S.Conn.finish(s, W.Http.text("403 Forbidden", "no thread folder or invalid path"))
    case True{}:
      IO.bind(List<&2, U32>, Unit, FVS.Fvs.get(root, path), +bytes => S.Conn.bot.mark(S.Conn.bot.marked(bytes), s, bytes))

def Fixture.route.k(+route: String, +path: String, +headers: List<&2, W.Header>, s: Socket, +st: M.State, +home: String, +inbox: Chan(S.Msg)) -> IO(Unit):
  match route:
    case "/rpc": Fixture.request(st, path, s)
    case "/checkpoint": Fixture.step(B.Hub.git(st, 1, "1", "checkpoint", Fixture.param(path, "thread"), "", ""), s)
    case "/view/get":
      Fixture.read(RV.Rview.ask.ok(route, RV.Rview.root(home, st, Fixture.param(path, "thread"), ""), RV.Rview.proot(st, Fixture.param(path, "thread")), "", Fixture.param(path, "path")),
        RV.Rview.root(home, st, Fixture.param(path, "thread"), ""), Fixture.param(path, "path"), s)
    case "/img": S.Img.serve(True{}, s, Fixture.param(path, "path"), "")
    case "/files/get": S.FilesHttp.serve(True{}, False{}, s, path, "", inbox)
    case "/files/zip": S.FilesHttp.serve(True{}, True{}, s, path, "", inbox)
    case _: S.Conn.finish(s, W.Http.text("404 Not Found", "fixture route"))

def Fixture.route.allowed(ok: Bool, +route: String, +path: String, +headers: List<&2, W.Header>, s: Socket, +st: M.State, +home: String, +inbox: Chan(S.Msg)) -> IO(Unit):
  match ok:
    case False{}: S.Conn.finish(s, W.Http.text("401 Unauthorized", "fixture token required"))
    case True{}: Fixture.route.k(route, path, headers, s, st, home, inbox)

def Fixture.route(req: W.Request, s: Socket, +st: M.State, +home: String, +inbox: Chan(S.Msg)) -> IO(Unit):
  match req:
    case W.Request{_, +path, +headers}:
      Fixture.route.allowed(S.Conn.allowed(headers, path, "paired-fixture"), W.Http.route(path), path, headers, s, st, home, inbox)

def Fixture.recv(r: Socket & Result<&1, &1, U32 & String, List<&2, U32>>, +st: M.State, +home: String, +inbox: Chan(S.Msg)) -> IO(Unit):
  (s, got) = r
  match got:
    case Done{bytes}: Fixture.route(W.Http.request(bytes), s, st, home, inbox)
    case Fail{_}: Socket.close(s)

def Fixture.accepted(r: Listener & Result<&1, &1, U32 & String, Socket>, +st: M.State, +home: String, +inbox: Chan(S.Msg)) -> IO(Listener):
  (listener, got) = r
  match got:
    case Fail{_}: IO.pure(Listener, listener)
    case Done{s}:
      do IO<Listener>:
        IO.spawn(Unit, IO.bind(Socket & Result<&1, &1, U32 & String, List<&2, U32>>, Unit, H.Sock.recv_bytes(s, 65536), r => Fixture.recv(r, st, home, inbox)))
        return listener

def Fixture.accept(fuel: Nat, listener: Listener, +st: M.State, +home: String, +inbox: Chan(S.Msg)) -> IO(Unit):
  match fuel:
    case 0n: Listener.close(listener)
    case 1n+n:
      do IO<Unit>:
        r : Listener & Result<&1, &1, U32 & String, Socket> <- TCP.accept(listener)
        next : Listener <- Fixture.accepted(r, st, home, inbox)
        Fixture.accept(n, next, st, home, inbox)

def main() -> IO(Unit):
  do IO<Unit>:
    root : String <- S.Env.get("FILES_TEST_ROOT", "")
    +home : String <- S.Env.get("FILES_TEST_HOME", "")
    port : String <- S.Env.get("FILES_TEST_PORT", "0")
    +st : M.State = Fixture.state(root)
    +inbox : Chan(S.Msg) <- Chan.new(S.Msg, 32)
    IO.spawn(Unit, Fixture.root.loop(10000n, st, home, inbox))
    listener : Listener <- IO.try(Listener, TCP.listen("127.0.0.1", Maybe.default(&2, U32, U32.read(port), 0)))
    IO.print("THREAD_FOLDER_HTTP_READY")
    Fixture.accept(10000n, listener, st, home, inbox)
