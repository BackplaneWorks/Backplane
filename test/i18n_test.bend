def Test.maybe(m: Maybe<&2, String>) -> String:
  match m:
    case None{}:
      "None"
    case Some{s}:
      "Some " ++ s

def Test.strings(xs: List<&2, String>) -> String:
  match xs:
    case Nil{}:
      ""
    case h <> t:
      h ++ ";" ++ Test.strings(t)

def Test.sorted(xs: List<&2, String>) -> Bool:
  match xs:
    case Nil{}: True{}
    case +a <> Nil{}: True{}
    case +a <> +b <> +t: Bool.and(String.is_le(a, b), Test.sorted(b <> t))

def Test.has(+all: String, k: String) -> String:
  Bool.show(String.contains(all, ";" ++ k ++ ";"))

def main() -> IO(Unit):
