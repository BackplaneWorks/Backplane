import Base
import ./check.bend as C
import ../src/core/exe.bend as EX

def main() -> IO(Unit):
  do IO<Unit>:
    C.Check.str("server PATH name", Bool.show(EX.Exe.server(["backplane-serve"])), "True")
    C.Check.str("server relative path", Bool.show(EX.Exe.server(["dist/backplane-serve", "--port", "3799"])), "True")
    C.Check.str("server absolute path", Bool.show(EX.Exe.server(["/tmp/bin/backplane-serve"])), "True")
    C.Check.str("app entry", Bool.show(EX.Exe.server(["/tmp/backplane"])), "False")
    C.Check.str("argument is not program", Bool.show(EX.Exe.server(["backplane", "backplane-serve"])), "False")
    C.Check.str("suffix is not basename", Bool.show(EX.Exe.server(["/tmp/my-backplane-serve"])), "False")
    C.Check.str("trailing text is not server", Bool.show(EX.Exe.server(["backplane-serve-old"])), "False")
    C.Check.str("no executable name", Bool.show(EX.Exe.server([])), "False")
    C.Check.str("path deleted", EX.Exe.path("/a/backplane (deleted)"), "/a/backplane")
    C.Check.str("child deleted", EX.Exe.child("/a/backplane (deleted)"), "/proc/self/exe")
    C.Check.str("gone deleted", Bool.show(EX.Exe.gone("/a/backplane (deleted)")), "True")
    C.Check.str("path plain", EX.Exe.path("/a/backplane"), "/a/backplane")
    C.Check.str("child plain", EX.Exe.child("/a/backplane"), "/a/backplane")
    C.Check.str("gone plain", Bool.show(EX.Exe.gone("/a/backplane")), "False")
    C.Check.str("path empty", EX.Exe.path(""), "")
    C.Check.str("child empty", EX.Exe.child(""), "")
    C.Check.str("gone empty", Bool.show(EX.Exe.gone("")), "False")
    C.Check.str("path middle", EX.Exe.path("/a/ (deleted)/backplane"), "/a/ (deleted)/backplane")
    C.Check.str("child middle", EX.Exe.child("/a/ (deleted)/backplane"), "/a/ (deleted)/backplane")
    C.Check.str("gone middle", Bool.show(EX.Exe.gone("/a/ (deleted)/backplane")), "False")
    C.Check.str("path marker alone", EX.Exe.path(" (deleted)"), "")
    C.Check.str("child marker alone", EX.Exe.child(" (deleted)"), "/proc/self/exe")
    C.Check.str("gone marker alone", Bool.show(EX.Exe.gone(" (deleted)")), "True")
    C.Check.str("path no leading space", EX.Exe.path("/a/backplane(deleted)"), "/a/backplane(deleted)")
    C.Check.str("child no leading space", EX.Exe.child("/a/backplane(deleted)"), "/a/backplane(deleted)")
    C.Check.str("gone no leading space", Bool.show(EX.Exe.gone("/a/backplane(deleted)")), "False")
    C.Check.str("path trailing text", EX.Exe.path("/a/backplane (deleted)x"), "/a/backplane (deleted)x")
    C.Check.str("child trailing text", EX.Exe.child("/a/backplane (deleted)x"), "/a/backplane (deleted)x")
    C.Check.str("gone trailing text", Bool.show(EX.Exe.gone("/a/backplane (deleted)x")), "False")
    C.Check.str("path one marker removed", EX.Exe.path("/a/backplane (deleted) (deleted)"), "/a/backplane (deleted)")
