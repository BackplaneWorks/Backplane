{
 "note": "Client-agnostic journeys for docs/final-gate.json. Each step is a verb from the vocabulary in CONTRACT.md. `needs` names capabilities a client adapter must declare; an adapter that lacks one reports the journey as `blocked: <capability>`, never as pass. `measure` says which frame metrics the journey feeds.",
 "refresh_hz_budget": {"gpui": 60, "ios": 120, "android": 90},
 "journeys": [
  {"id": "pair", "item": "Pair", "measure": ["click"],
   "steps": [{"do": "pair", "with": "invite"}, {"do": "expect", "sidebar": true}],
   "needs": ["pair"]},
  {"id": "projects-threads", "item": "Open projects and threads", "measure": ["click", "scroll"],
   "steps": [{"do": "open_project", "name": "e2e"}, {"do": "select_thread", "index": 0}, {"do": "scroll", "target": "thread", "screens": 3}, {"do": "select_thread", "index": 5}, {"do": "expect", "history": true}],
   "needs": ["select", "scroll"]},
  {"id": "send-image", "item": "Send, reply and paste an image", "measure": ["click", "layout"],
   "steps": [{"do": "select_thread", "index": 1}, {"do": "type", "text": "here is a picture"}, {"do": "paste_image", "file": "fixtures/pic.png"}, {"do": "send"}, {"do": "wait_reply", "secs": 20}, {"do": "expect", "image_in_thread": true}],
   "needs": ["select", "type", "send", "paste_image", "wait_reply"]},
  {"id": "stream", "item": "Watch a running turn stream", "measure": ["stream", "layout"],
   "steps": [{"do": "select_thread", "index": 2}, {"do": "type", "text": "zqlong stream please"}, {"do": "send"}, {"do": "watch_stream", "secs": 20}, {"do": "expect", "growing_reply": true}],
   "needs": ["select", "type", "send", "watch_stream"]},
  {"id": "switch-fast", "item": "Switch threads fast", "measure": ["click", "layout"],
   "steps": [{"do": "switch_burst", "count": 60, "gap_ms": 120}, {"do": "expect", "last_thread_shown": true}],
   "needs": ["select"]},
  {"id": "popups", "item": "Mention and command popups", "measure": ["click", "layout"],
   "steps": [{"do": "select_thread", "index": 3}, {"do": "popup", "trigger": "/"}, {"do": "popup", "trigger": "@"}, {"do": "popup", "trigger": ">"}, {"do": "popup", "trigger": "%"}, {"do": "popup", "trigger": "$"}],
   "needs": ["select", "popup"]},
  {"id": "bots-rooms", "item": "Bots and rooms", "measure": ["click", "layout"],
   "steps": [{"do": "open_bots"}, {"do": "open_bot", "index": 0}, {"do": "open_rooms"}, {"do": "open_room", "index": 0}, {"do": "post_room", "text": "hello room"}],
   "needs": ["bots", "rooms"]},
  {"id": "viewers", "item": "Open Board, Schematic and 3D viewers", "measure": ["click", "scroll"],
   "steps": [{"do": "open_viewer", "kind": "board"}, {"do": "pan_zoom", "frames": 120}, {"do": "open_viewer", "kind": "schematic"}, {"do": "pan_zoom", "frames": 120}, {"do": "open_viewer", "kind": "3d"}, {"do": "orbit", "frames": 120}],
   "needs": ["viewer_board", "viewer_schematic", "viewer_3d"]},
  {"id": "downloads", "item": "Download files", "measure": ["click"],
   "steps": [{"do": "open_files"}, {"do": "download", "file": "readme.txt"}, {"do": "expect", "file_saved": "readme.txt"}],
   "needs": ["files", "download"]},
  {"id": "settings", "item": "Settings", "measure": ["click", "layout", "dead"],
   "steps": [{"do": "open_settings"}, {"do": "click_every_control", "scope": "settings"}],
   "needs": ["settings", "controls"]},
  {"id": "reconnect", "item": "Reconnect after sleep", "measure": ["click"],
   "steps": [{"do": "select_thread", "index": 0}, {"do": "sleep_network", "secs": 45}, {"do": "wake_network"}, {"do": "expect", "reconnected_within_s": 10, "no_lost_items": true}],
   "needs": ["select", "network_sleep"]},
  {"id": "dead-controls", "item": "No dead buttons", "measure": ["click", "dead"],
   "steps": [{"do": "select_thread", "index": 0}, {"do": "click_every_control", "scope": "screen"}],
   "needs": ["select", "controls"]},
  {"id": "long-session", "item": "Long session with 20 simulated agents", "measure": ["stream", "scroll", "layout", "memory"],
   "steps": [{"do": "agents", "count": 20}, {"do": "session", "minutes": 30, "actions": "random_walk"}, {"do": "expect", "no_growth_rss": true}],
   "needs": ["select", "scroll", "popup", "agents", "memory"]}
 ],
 "dead_control_sweep": {"note": "every visible, enabled control on every screen reached by the journeys is clicked once; a control whose click changes neither the shown state nor sends an action is DEAD", "needs": ["controls"]}
}
