{
 "note": "Client-agnostic journeys for docs/final-gate.json. Each step is a verb from the vocabulary in CONTRACT.md. `needs` names capabilities a client adapter must declare; an adapter that lacks one reports the journey as `blocked: <capability>`, never as pass. `measure` says which frame metrics the journey feeds.",
 "refresh_hz_budget": {"gpui": 60, "ios": 120, "android": 90},
 "journeys": [
  {"id": "pair", "item": "Pair", "measure": ["click"],
   "steps": [{"do": "pair", "with": "invite"}, {"do": "expect", "sidebar": true}],
   "needs": ["pair"]},
  {"id": "projects-threads", "item": "Open projects and threads", "measure": ["click", "scroll"],
   "steps": [{"do": "open_project", "name": "e2e"}, {"do": "select_thread", "index": 0}, {"do": "scroll", "target": "thread", "screens": 3}, {"do": "select_thread", "index": 5}, {"do": "expect", "history": true}],
   "needs": ["select", "scroll"]},
  {"id": "send-image", "item": "Send, reply and paste an image", "measure": ["click", "layout"],
   "steps": [{"do": "select_thread", "index": 1}, {"do": "type", "text": "here is a picture"}, {"do": "paste_image", "file": "fixtures/pic.png"}, {"do": "send"}, {"do": "wait_reply", "secs": 20}, {"do": "expect", "image_in_thread": true}],
   "needs": ["select", "type", "send", "paste_image", "wait_reply"]},
  {"id": "stream", "item": "Watch a running turn stream", "measure": ["stream", "layout"],
   "steps": [{"do": "select_thread", "index": 2}, {"do": "type", "text": "zqlong stream please"}, {"do": "send"}, {"do": "watch_stream", "secs": 20}, {"do": "expect", "growing_reply": true}],
   "needs": ["select", "type", "send", "watch_stream"]},
  {"id": "switch-fast", "item": "Switch threads fast", "measure": ["click", "layout"],
   "steps": [{"do": "switch_burst", "count": 60, "gap_ms": 120}, {"do": "expect", "last_thread_shown": true}],
   "needs": ["select"]},
  {"id": "popups", "item": "Mention and command popups", "measure": ["click", "layout"],
   "steps": [{"do": "select_thread", "index": 3}, {"do": "popup", "trigger": "/"}, {"do": "popup", "trigger": "@"}, {"do": "popup", "trigger": ">"}, {"do": "popup", "trigger": "%"}, {"do": "popup", "trigger": "$"}],
   "needs": ["select", "popup"]},
  {"id": "bots-rooms", "item": "Bots and rooms", "measure": ["click", "layout"],
   "steps": [{"do": "open_bots"}, {"do": "open_bot", "index": 0}, {"do": "open_rooms"}, {"do": "open_room", "index": 0}, {"do": "post_room", "text": "hello room"}],
   "needs": ["bots", "rooms"]},
  {"id": "viewers", "item": "Open Board, Schematic and 3D viewers", "measure": ["click", "scroll"],
   "steps": [{"do": "open_viewer", "kind": "board"}, {"do": "pan_zoom", "frames": 120}, {"do": "open_viewer", "kind": "schematic"}, {"do": "pan_zoom", "frames": 120}, {"do": "open_viewer", "kind": "3d"}, {"do": "orbit", "frames": 120}],
   "needs": ["viewer_board", "viewer_schematic", "viewer_3d"]},
  {"id": "downloads", "item": "Download files", "measure": ["click"],
   "steps": [{"do": "open_files"}, {"do": "download", "file": "readme.txt"}, {"do": "expect", "file_saved": "readme.txt"}],
   "needs": ["files", "download"]},
  {"id": "settings", "item": "Settings", "measure": ["click", "layout", "dead"],
   "steps": [{"do": "open_settings"}, {"do": "click_every_control", "scope": "settings"}],
   "needs": ["settings", "controls"]},
  {"id": "reconnect", "item": "Reconnect after sleep", "measure": ["click"],
   "steps": [{"do": "select_thread", "index": 0}, {"do": "sleep_network", "secs": 45}, {"do": "wake_network"}, {"do": "expect", "reconnected_within_s": 10, "no_lost_items": true}],
   "needs": ["select", "network_sleep"]},
  {"id": "dead-controls", "item": "No dead buttons", "measure": ["click", "dead"],
   "steps": [{"do": "select_thread", "index": 0}, {"do": "click_every_control", "scope": "screen"}],
   "needs": ["select", "controls"]},
  {"id": "long-session", "item": "Long session with 20 simulated agents", "measure": ["stream", "scroll", "layout", "memory"],
   "steps": [{"do": "agents", "count": 20}, {"do": "session", "minutes": 30, "actions": "random_walk"}, {"do": "expect", "no_growth_rss": true}],
   "needs": ["select", "scroll", "popup", "agents", "memory"]}
 ],
 "dead_control_sweep": {"note": "every visible, enabled control on every screen reached by the journeys is clicked once; a control whose click changes neither the shown state nor sends an action is DEAD", "needs": ["controls"]},
 "step_budgets_ms": {"note": "what a person waits for, per step (ok up to the first number, slow up to the second, fail past it; skills/backplane-e2e's budgets). The one-frame claim stays on G1's ack against refresh_hz_budget.", "press": [300, 2000], "navigation": [1000, 3000], "viewer": [5000, 15000], "reply": [3000, 8000], "network": [10000, 20000]},
 "stories_note": "User-story journeys (test/e2e/stories.md) and the day-in-the-life walks. `story` names the story; `seed` the hub they want (lived-in: lib/seed.mjs); `--journey stories|day|story:S04|<id>` runs them on their own hub, never in the gate mapping. Stories the gate journeys already cover are in stories.md, not repeated here.",
 "stories": [
  {"id": "s01-first-run", "story": "S01", "item": "First run: the tour, then Settings", "platforms": "G A", "measure": ["click"], "steps": [{"do": "needs", "what": "tour"}], "needs": ["tour"]},
  {"id": "s02-add-project", "story": "S02", "item": "Add a project from the folder picker", "platforms": "G A", "measure": ["click"], "steps": [{"do": "fs", "op": "copy", "from": "amp", "to": "extra"}, {"do": "click", "control": "ui:Add project"}, {"do": "field", "name": "picker", "text": "$ROOT/extra", "wait": 1500}, {"do": "view_action", "action": "proj-add", "value": "$ROOT/extra"}, {"do": "open_project", "index": 0}, {"do": "open_viewer", "kind": "board"}], "needs": ["select", "fs_ops", "viewer_board"], "seed": "lived-in", "note": "the picker's highlighted row + Enter needs keys; the add is sent as the row's own action"},
  {"id": "s03-find", "story": "S03", "item": "Find a project, then a word in any thread", "platforms": "G A", "measure": ["click"], "steps": [{"do": "click", "control": "ui:Search"}, {"do": "field", "name": "pq", "text": "sens", "wait": 1200}, {"do": "field", "name": "pq", "text": "", "wait": 800}, {"do": "search", "text": "decoupling"}], "needs": ["search"]},
  {"id": "s04-send-watch", "story": "S04", "item": "Send and watch the reply, then type in another thread at once", "platforms": "G A", "measure": ["click", "stream", "layout"], "steps": [{"do": "select_thread", "index": 1}, {"do": "type", "text": "Check the regulator again watch"}, {"do": "send"}, {"do": "watch_stream", "secs": 6}, {"do": "select_thread", "index": 2}, {"do": "type", "text": "next"}, {"do": "expect", "composer": "next"}, {"do": "expect", "hub": {"working": 0}}], "needs": ["select", "type", "send", "watch_stream", "read"]},
  {"id": "s05-stop", "story": "S05", "item": "Stop a turn; the composer takes the next message", "platforms": "G A", "measure": ["click", "layout"], "steps": [{"do": "select_thread", "index": 3}, {"do": "type", "text": "Please hold:8000 stopme"}, {"do": "send"}, {"do": "wait_reply", "secs": 1.5}, {"do": "thread_action", "action": "interrupt", "wait": 2000}, {"do": "expect", "hub": {"working": 0}}, {"do": "type", "text": "again after the stop"}, {"do": "send"}, {"do": "wait_reply", "secs": 6}], "needs": ["select", "type", "send", "thread_actions"]},
  {"id": "s06-steer", "story": "S06", "item": "A follow-up while a turn runs: nothing jumps", "platforms": "G A", "measure": ["click", "layout"], "steps": [{"do": "select_thread", "index": 1}, {"do": "type", "text": "hold:6000 first"}, {"do": "send"}, {"do": "wait_reply", "secs": 1}, {"do": "type", "text": "and the second, steer"}, {"do": "send"}, {"do": "wait_reply", "secs": 8}], "needs": ["select", "type", "send"]},
  {"id": "s07-long-history", "story": "S07", "item": "Long history: to the first message and back, no jumps", "platforms": "G A", "measure": ["click", "scroll", "layout"], "steps": [{"do": "select_thread", "index": 0}, {"do": "scroll_state", "name": "end"}, {"do": "scroll", "screens": 6, "up": true}, {"do": "scroll_state", "name": "back"}, {"do": "expect", "scroll_dups": 0}], "needs": ["select", "scroll"], "seed": "lived-in"},
  {"id": "s08-read-while-streaming", "story": "S08", "item": "Reading while it streams: the view holds", "platforms": "G A", "measure": ["click", "layout"], "steps": [{"do": "select_thread", "index": 1}, {"do": "type", "text": "stream while I read"}, {"do": "send"}, {"do": "wait_reply", "secs": 0.8}, {"do": "scroll_by", "px": -600}, {"do": "scroll_by", "px": -600}, {"do": "scroll_state", "name": "held"}, {"do": "wait_reply", "secs": 2}, {"do": "scroll_state", "name": "held-later"}, {"do": "expect", "scroll_same": ["held", "held-later"]}], "needs": ["select", "type", "send", "scroll"]},
  {"id": "s09-lifecycle", "story": "S09", "item": "Thread lifecycle: pin, archive, delete (asks first)", "platforms": "G A", "measure": ["click"], "steps": [{"do": "select_thread", "index": 4}, {"do": "thread_action", "action": "pin"}, {"do": "select_thread", "index": 6}, {"do": "thread_action", "action": "archive"}, {"do": "select_thread", "index": 6}, {"do": "thread_action", "action": "delete"}, {"do": "thread_action", "action": "delete"}, {"do": "rename", "title": "renamed"}, {"do": "expect", "hub": {"pinned": 1, "archived": 1, "threads": -2}}], "needs": ["select", "thread_actions", "rename"], "seed": "lived-in"},
