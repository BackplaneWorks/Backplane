import Base
import ./proc.bend as P
import ./host.bend as H

# Read-only allowance probe for a background server job, never its event loop.
# Contract: provider, at (last reading), attempted_at (last attempt), state,
# auth, windows, source. Cache and permanent fcntl lock are private 0600 files.
# Reads within 300 seconds or while another worker holds the lock reuse cache.
# Errors retain old windows only with a verified same-account salted digest;
# unknown identity clears windows. No raw account identifier is persisted.
# A window's name is the exact provider label (else bucket ID, else unknown)
# plus /primary or /secondary. scope is the exact reported limitId, falling
# back to the multi-bucket map key; neither is a model identifier.
# Usage is ceil(usedPercent * 10), 0..1000. Invalid input rejects the reading.
# Null resets/durations stay null. At most 16 buckets / 32 windows, each
# provider label/ID at most 128 printable characters; oversized data rejects.
# Supported protocol: https://learn.chatgpt.com/docs/app-server
# The script is embedded so the built server needs no source-tree helper.

def AllowanceIO.script() -> String:
  String.join([
    "import decimal",
    "import fcntl",
    "import hashlib",
    "import hmac",
    "import stat",
    "import json",
    "import math",
    "import os",
    "import selectors",
    "import signal",
    "import subprocess",
    "import sys",
    "import time",
    "",
    "# One private stdio child, never a shared daemon. No files containing auth",
    "# are opened here; the signed-in CLI alone manages its credentials.",
    "MAX_BUCKETS = 16",
    "MAX_BYTES = 1048576",
    "MAX_LINE = 262144",
    "MAX_MESSAGES = 256",
    "proc = None",
    "selector = None",
    "buffer = b''",
    "bytes_read = 0",
    "messages_read = 0",
    "deadline = time.monotonic() + 10.0",
    "auth = 'unknown'",
    "state = 'error'",
    "windows = []",
    "",
    "class Unavailable(Exception):",
    "    pass",
    "",
    "class ProtocolError(Exception):",
    "    pass",
    "",
    "class RpcError(Exception):",
    "    def __init__(self, code):",
    "        self.code = code",
    "",
    "def expired(*_):",
    "    raise TimeoutError()",
    "",
    "def reject_constant(_):",
    "    raise ProtocolError()",
    "",
    "def send(message):",
    "    data = json.dumps(message, separators=(',', ':')).encode() + b'\\n'",
    "    while data:",
    "        if time.monotonic() >= deadline:",
    "            raise TimeoutError()",
    "        count = os.write(proc.stdin.fileno(), data)",
    "        data = data[count:]",
    "",
    "def receive():",
    "    global buffer, bytes_read, messages_read",
    "    while True:",
    "        if time.monotonic() >= deadline:",
    "            raise TimeoutError()",
    "        if b'\\n' in buffer:",
    "            line, buffer = buffer.split(b'\\n', 1)",
    "            messages_read += 1",
    "            if len(line) > MAX_LINE or messages_read > MAX_MESSAGES:",
    "                raise ProtocolError()",
    "            value = json.loads(line, parse_float=decimal.Decimal,",
    "                               parse_constant=reject_constant)",
    "            if not isinstance(value, dict):",
    "                raise ProtocolError()",
    "            # Never answer host auth/approval requests or copy their fields.",
    "            if 'method' in value:",
    "                if 'id' in value:",
    "                    raise ProtocolError()",
    "                continue",
    "            return value",
    "        if len(buffer) > MAX_LINE:",
    "            raise ProtocolError()",
    "        if not selector.select(max(0, deadline - time.monotonic())):",
    "            raise TimeoutError()",
    "        chunk = os.read(proc.stdout.fileno(), 65536)",
    "        if not chunk:",
    "            raise ProtocolError()",
    "        bytes_read += len(chunk)",
    "        if bytes_read > MAX_BYTES:",
    "            raise ProtocolError()",
    "        buffer += chunk",
    "",
    "def result(message):",
    "    if 'error' in message:",
    "        error = message['error']",
    "        code = error.get('code') if isinstance(error, dict) else None",
    "        raise RpcError(code if type(code) is int else None)",
    "    value = message.get('result')",
    "    if not isinstance(value, dict):",
    "        raise ProtocolError()",
    "    return value",
    "",
    "def label(value):",
    "    if value is None:",
    "        return None",
    "    if (not isinstance(value, str) or not value or len(value) > 128",
    "            or len(value.encode('utf-8')) > 512 or not value.isprintable()):",
    "        raise ProtocolError()",
    "    return value",
    "",
    "def reported_integer(value):",
    "    if value is None:",
    "        return None",
    "    if type(value) is not int or not 0 <= value <= 9007199254740991:",
    "        raise ProtocolError()",
    "    return value",
    "",
    "def window_rows(limits):",
    "    buckets = limits.get('rateLimitsByLimitId')",
    "    if buckets is None:",
    "        legacy = limits.get('rateLimits')",
    "        buckets = {} if legacy is None else {None: legacy}",
    "    if not isinstance(buckets, dict) or len(buckets) > MAX_BUCKETS:",
    "        raise ProtocolError()",
    "    rows = []",
    "    for key, bucket in buckets.items():",
    "        if not isinstance(bucket, dict):",
    "            raise ProtocolError()",
    "        key = label(key)",
    "        scope = label(bucket.get('limitId'))",
    "        if scope is None:",
    "            scope = key",
    "        title = label(bucket.get('limitName'))",
    "        for kind in ('primary', 'secondary'):",
    "            window = bucket.get(kind)",
    "            if window is None:",
    "                continue",
    "            if not isinstance(window, dict):",
    "                raise ProtocolError()",
    "            used = window.get('usedPercent')",
    "            if (type(used) not in (int, decimal.Decimal)",
    "                    or not decimal.Decimal(used).is_finite() or not 0 <= used <= 100):",
    "                raise ProtocolError()",
    "            parts = decimal.Decimal(used).as_tuple()",
    "            scaled = decimal.Decimal((parts.sign, parts.digits, parts.exponent + 1))",
    "            rows.append({'name': (title or scope or 'unknown') + '/' + kind,",
    "                         'used_permille': math.ceil(scaled),",
    "                         'resets_at': reported_integer(window.get('resetsAt')),",
    "                         'duration_minutes': reported_integer(window.get('windowDurationMins')),",
    "                         'scope': scope, 'shared': True})",
    "    return rows",
    "",
    "",
    "def snapshot(state='error', auth='unknown', windows=None, at=0, attempted_at=0, phase='complete'):",
    "    return {'provider': 'codex', 'at': at, 'attempted_at': attempted_at,",
    "            'state': state, 'auth': auth, 'windows': windows or [],",
    "            'source': 'codex-app-server', 'phase': phase}",
    "",
    "",
    "def probe():",
    "    global proc, selector",
    "    auth = 'unknown'",
    "    state = 'error'",
    "    windows = []",
    "    identity = None",
    "    account_checked = False",
    "    try:",
    "        signal.signal(signal.SIGALRM, expired)",
    "        proc = subprocess.Popen(['codex', '-c', 'features.daemon_auto_start=false',",
    "                                 '-c', 'analytics.enabled=false',",
    "                                 '-c', 'otel.trace_exporter=\"none\"',",
    "                                 'app-server', '--listen', 'stdio://'],",
    "                                stdin=subprocess.PIPE, stdout=subprocess.PIPE,",
    "                                stderr=subprocess.DEVNULL, bufsize=0, cwd='/',",
    "                                start_new_session=False)",
    "        signal.setitimer(signal.ITIMER_REAL, max(0.001, deadline - time.monotonic()))",
    "        selector = selectors.DefaultSelector()",
    "        selector.register(proc.stdout, selectors.EVENT_READ)",
    "        send({'id': 1, 'method': 'initialize',",
    "              'params': {'clientInfo': {'name': 'backplane_allowance', 'version': '1'}}})",
    "        initialized = receive()",
    "        if type(initialized.get('id')) is not int or initialized['id'] != 1:",
    "            raise ProtocolError()",
    "        result(initialized)",
    "        send({'method': 'initialized', 'params': {}})",
    "        # Independent reads share one deadline; replies may arrive in either order.",
    "        send({'id': 2, 'method': 'account/read', 'params': {'refreshToken': False}})",
    "        send({'id': 3, 'method': 'account/rateLimits/read'})",
    "        replies = {}",
    "        while len(replies) < 2:",
    "            message = receive()",
    "            ident = message.get('id')",
    "            if type(ident) is not int or ident not in (2, 3) or ident in replies:",
    "                raise ProtocolError()",
    "            replies[ident] = message",
    "            if ident == 2:",
    "                account = result(message).get('account')",
    "                if account is not None and not isinstance(account, dict):",
    "                    raise ProtocolError()",
    "                mode = account.get('type') if account else None",
    "                auth = 'chatgpt' if mode == 'chatgpt' else 'apikey' if mode == 'apiKey' else 'unknown'",
    "                account_checked = True",
    "                if auth != 'chatgpt':",
    "                    raise Unavailable()",
    "        limits = result(replies[3])",
    "        ident = limits.get('accountId')",
    "        # Internal equality proof only, never part of the public snapshot/cache.",
    "        identity = ident if isinstance(ident, str) and 0 < len(ident) <= 4096 else None",
    "        windows = window_rows(limits)",
    "        state = 'ok' if windows else 'unavailable'",
    "    except (FileNotFoundError, Unavailable):",
    "        state = 'unavailable'",
    "        windows = []",
    "    except RpcError as error:",
    "        state = 'unavailable' if error.code == -32601 else 'error'",
    "        windows = []",
    "    except Exception:",
    "        state = 'error'",
    "        windows = []",
    "    finally:",
    "        # The outer supervisor owns this private session and all descendants.",
    "        # No asynchronous exception is raised during Popen construction.",
    "        signal.setitimer(signal.ITIMER_REAL, 0)",
    "        if proc is not None:",
    "            try:",
    "                proc.kill()",
    "            except ProcessLookupError:",
    "                pass",
    "            try:",
    "                proc.wait(timeout=0.5)",
    "            except Exception:",
    "                pass",
    "            proc.stdin.close()",
    "            proc.stdout.close()",
    "        if selector is not None:",
    "            selector.close()",
    "",
    "    return snapshot(state, auth, windows, int(time.time())), identity, account_checked",
    "",
    "",
    "# Cache and lock are private regular files; neither follows a final symlink.",
    "# The permanent lock inode must never be replaced or removed.",
    "MAX_CACHE = 131072",
    "",
    "",
    "def encoded(value):",
    "    return (json.dumps(value, separators=(',', ':'), allow_nan=False, ensure_ascii=False) + '\\n').encode()",
    "",
    "",
    "def private_fd(directory, name, flags):",
    "    fd = os.open(name, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,",
    "                 0o600, dir_fd=directory)",
    "    try:",
    "        info = os.fstat(fd)",
    "        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:",
    "            raise ProtocolError()",
    "        os.fchmod(fd, 0o600)",
    "        return fd",
    "    except Exception:",
    "        os.close(fd)",
    "        raise",
    "",
    "",
    "def cached_snapshot(value):",
    "    if (not isinstance(value, dict) or value.get('provider') != 'codex'",
    "            or value.get('source') != 'codex-app-server'",
    "            or value.get('phase', 'complete') not in ('pending', 'complete')",
    "            or value.get('state') not in ('ok', 'unavailable', 'error')",
    "            or value.get('auth') not in ('chatgpt', 'apikey', 'unknown')):",
    "        raise ProtocolError()",
    "    at = reported_integer(value.get('at'))",
    "    attempted = reported_integer(value.get('attempted_at', at))",
    "    if at is None or attempted is None:",
    "        raise ProtocolError()",
    "    rows = value.get('windows')",
    "    if not isinstance(rows, list) or len(rows) > MAX_BUCKETS * 2:",
    "        raise ProtocolError()",
    "    clean = []",
    "    for row in rows:",
    "        if not isinstance(row, dict):",
    "            raise ProtocolError()",
    "        name = row.get('name')",
    "        used = row.get('used_permille')",
    "        if (not isinstance(name, str) or not name or len(name) > 138",
    "                or not name.isprintable() or len(name.encode('utf-8')) > 552",
    "                or type(used) is not int or not 0 <= used <= 1000",
    "                or row.get('shared') is not True):",
    "            raise ProtocolError()",
    "        clean.append({'name': name, 'used_permille': used,",
    "                      'resets_at': reported_integer(row.get('resets_at')),",
    "                      'duration_minutes': reported_integer(row.get('duration_minutes')),",
    "                      'scope': label(row.get('scope')), 'shared': True})",
    "    # Sanitization applies on cache hits as well as on fresh wire replies.",
    "    if value['auth'] != 'chatgpt' or value['state'] == 'unavailable':",
    "        clean = []",
    "    return snapshot(value['state'], value['auth'], clean, at, attempted, value.get('phase', 'complete'))",
    "",
    "",
    "def read_cache(directory, name):",
    "    try:",
    "        fd = private_fd(directory, name, os.O_RDONLY)",
    "    except FileNotFoundError:",
    "        return None",
    "    try:",
    "        with os.fdopen(fd, 'rb') as stream:",
    "            raw = stream.read(MAX_CACHE + 1)",
    "        if len(raw) > MAX_CACHE:",
    "            return None",
    "        value = json.loads(raw, parse_constant=reject_constant)",
    "        return cached_snapshot(value), raw",
    "    except (ValueError, ProtocolError, UnicodeError):",
    "        return None",
    "",
    "",
    "def save_cache(directory, name, value):",
    "    temp = '.' + name + '.' + os.urandom(12).hex() + '.tmp'",
    "    try:",
    "        fd = private_fd(directory, temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL)",
    "        with os.fdopen(fd, 'wb') as stream:",
    "            stream.write(encoded(value))",
    "            stream.flush()",
    "            os.fsync(stream.fileno())",
    "        os.replace(temp, name, src_dir_fd=directory, dst_dir_fd=directory)",
    "        os.fsync(directory)",
    "    finally:",
    "        try:",
    "            os.unlink(temp, dir_fd=directory)",
    "        except FileNotFoundError:",
    "            pass",
    "",
    "",
    "def metadata(fd):",
    "    os.lseek(fd, 0, os.SEEK_SET)",
    "    try:",
    "        value = json.loads(os.read(fd, 4097))",
    "        if (not isinstance(value, dict) or not isinstance(value.get('key'), str)",
    "                or len(value['key']) != 64 or len(bytes.fromhex(value['key'])) != 32):",
    "            return {}",
    "        return value",
    "    except (ValueError, TypeError):",
    "        return {}",
    "",
    "",
    "def account_digest(key, identity):",
    "    if identity is None:",
    "        return None",
    "    return hmac.new(bytes.fromhex(key), identity.encode('utf-8'), hashlib.sha256).hexdigest()",
    "",
    "",
    "def save_metadata(fd, key, digest, value):",
    "    # Bind both files: a crash between the two saves cannot attach windows to",
    "    # a different account. Only salted digests are stored, never raw IDs/email.",
    "    raw = encoded({'key': key, 'owner_digest': digest,",
    "                   'cache_sha256': hashlib.sha256(encoded(value)).hexdigest()})",
    "    os.lseek(fd, 0, os.SEEK_SET)",
    "    os.ftruncate(fd, 0)",
    "    while raw:",
    "        raw = raw[os.write(fd, raw):]",
    "    os.fsync(fd)",
    "",
    "",
    "def reusable(pair, now):",
    "    # Match the hub: a future attempt is held until its clock catches up.",
    "    return pair is not None and pair[0]['attempted_at'] > 0 and now - pair[0]['attempted_at'] < 300",
    "",
    "",
    "def collect(cachepath):",
    "    directory = None",
    "    lock = None",
    "    attempted = int(time.time())",
    "    previous = None",
    "    try:",
    "        parent, name = os.path.split(os.path.abspath(cachepath))",
    "        if not name or name in ('.', '..'):",
    "            raise ProtocolError()",
    "        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)",
    "        if os.fstat(directory).st_uid != os.getuid():",
    "            raise ProtocolError()",
    "        previous = read_cache(directory, name)",
    "        lock = private_fd(directory, name + '.lock', os.O_RDWR | os.O_CREAT)",
    "        try:",
    "            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)",
    "        except BlockingIOError:",
    "            return previous[0] if previous else snapshot('unavailable')",
    "        # Another worker may have finished between the first read and flock.",
    "        previous = read_cache(directory, name)",
    "        attempted = int(time.time())",
    "        if reusable(previous, attempted):",
    "            return previous[0]",
    "        meta = metadata(lock)",
    "        key = meta.get('key') or os.urandom(32).hex()",
    "        old_at = previous[0]['at'] if previous else 0",
    "        # Record an attempt before invoking the CLI. An interrupted worker is",
    "        # throttled too; no force argument can bypass this five-minute gate.",
    "        pending = snapshot('error', at=old_at, attempted_at=attempted, phase='pending')",
    "        save_cache(directory, name, pending)",
    "        current, identity, account_checked = probe()",
    "        current['attempted_at'] = attempted",
    "        digest = account_digest(key, identity)",
    "        same_account = bool(previous and digest and previous[0]['auth'] == 'chatgpt'",
    "                            and current['auth'] == 'chatgpt'",
    "                            and meta.get('owner_digest') == digest",
    "                            and meta.get('cache_sha256') == hashlib.sha256(previous[1]).hexdigest())",
    "        if current['state'] == 'error' or (not account_checked and current['state'] != 'ok'):",
    "            current['state'] = 'error' if previous else current['state']",
    "            current['at'] = old_at",
    "            current['windows'] = previous[0]['windows'] if same_account else []",
    "            # A known account switch must not inherit the former reading time.",
    "            if digest and meta.get('owner_digest') and not same_account:",
    "                current['at'] = 0",
    "        # Successful no-auth/API-key/empty readings always replace old windows.",
    "        save_cache(directory, name, current)",
    "        save_metadata(lock, key, digest, current)",
    "        return current",
    "    except Exception:",
    "        failure = snapshot('error', at=previous[0]['at'] if previous else 0,",
    "                           attempted_at=attempted)",
    "        # Permission/path/save failures remain fixed sanitized output. Never",
    "        # report stale windows when current account identity is unverified.",
    "        return failure",
    "    finally:",
    "        if lock is not None:",
    "            os.close(lock)",
    "        if directory is not None:",
    "            os.close(directory)",
    "",
    "",
    "try:",
    "    answer = collect(sys.argv[1])",
    "except Exception:",
    "    answer = snapshot('error', attempted_at=int(time.time()))",
    "sys.stdout.write(encoded(answer)[:-1].decode())"
  ], "\n")

# A private session is created by the supervisor before Python starts. Its
# 11-second alarm includes Python startup/imports/Popen and kills that session
# on every exit, including after a successful probe, without touching the hub
# or a shared Codex daemon. Cleanup has a one-second margin inside 12 seconds.
def AllowanceIO.supervisor() -> String:
  "use POSIX (); my $p = fork(); defined($p) or exit 127; if (!$p) { POSIX::setsid() >= 0 or exit 127; exec('python3', '-I', '-c', $ARGV[0], $ARGV[1]); exit 127; } $SIG{ALRM} = sub { kill 9, -$p; kill 9, $p; waitpid($p, 0); exit 124; }; alarm 11; waitpid($p, 0); my $s = $?; alarm 0; kill 9, -$p; exit(($s & 127) ? 1 : ($s >> 8));"

# Fixed fallback also covers Python not being installed or failing to start;
# P.Proc.run combines stderr, so its unsanitized failure text is discarded.
def AllowanceIO.failure(state: String, now: U32) -> String:
  "{\"provider\":\"codex\",\"at\":0,\"attempted_at\":" ++ U32.show(now) ++ ",\"state\":\"" ++ state ++ "\",\"auth\":\"unknown\",\"windows\":[],\"source\":\"codex-app-server\",\"phase\":\"complete\"}"

# Successful stdout has exactly one producer: the embedded script's strict
# allowlist. Return it directly; reparsing up to 128 KiB in Bend can exhaust
# the worker stack. The CLI never inherits this stdout; its pipe is private.
def AllowanceIO.got(r: P.Ran, now: U32) -> String:
  match r:
    case P.Ran{0, out}:
      out
    case P.Ran{127, _}:
      AllowanceIO.failure("unavailable", now)
    case P.Ran{_, _}:
      AllowanceIO.failure("error", now)

# Python has a ten-second deadline; the supervisor enforces 11 seconds total.
# -I ignores Python startup environment; all subprocess stderr is discarded.
def AllowanceIO.read(+cachepath: String) -> IO(String):
  do IO<String>:
    r : P.Ran <- P.Proc.run("sh", ["-c", "exec perl -e \"$1\" -- \"$2\" \"$3\" 2>/dev/null", "sh", AllowanceIO.supervisor(), AllowanceIO.script(), cachepath], "/")
    now : U32 <- H.Clock.epoch()
    return AllowanceIO.got(r, now)
