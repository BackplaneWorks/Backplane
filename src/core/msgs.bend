def T.native.hub.failure(l: I.Loc, +arg0: String, arg1: String) -> String:
  match l:
    case I.En{}:
      I.I18n.sel(arg0, "timeout", "Hub response timed out; retrying", I.I18n.sel(arg0, "network", "Cannot reach hub; check Tailscale and network access", I.I18n.sel(arg0, "dns", "Hub address not found; check Tailscale", I.I18n.sel(arg0, "tls", "Secure connection failed; check the hub certificate", I.I18n.sel(arg0, "authentication", "Hub rejected credentials; check the pairing link", I.I18n.sel(arg0, "address", "Invalid hub address; check the pairing link", I.I18n.sel(arg0, "response", "Invalid hub response; retrying", I.I18n.sel(arg0, "view", "Hub view unavailable; reconnecting", I.I18n.sel(arg0, "http", "Hub returned HTTP " ++ arg1 ++ "; retrying", "Connection lost; retrying")))))))))
    case I.Ja{}:
      I.I18n.sel(arg0, "timeout", "ハブの応答がタイムアウトしました・再接続中", I.I18n.sel(arg0, "network", "ハブに接続できません。Tailscaleとネットワークへのアクセスを確認してください", I.I18n.sel(arg0, "dns", "ハブのアドレスが見つかりません。Tailscaleを確認してください", I.I18n.sel(arg0, "tls", "安全な接続に失敗しました。ハブの証明書を確認してください", I.I18n.sel(arg0, "authentication", "ハブが認証情報を拒否しました。ペアリングリンクを確認してください", I.I18n.sel(arg0, "address", "ハブのアドレスが無効です。ペアリングリンクを確認してください", I.I18n.sel(arg0, "response", "ハブの応答が無効です・再接続中", I.I18n.sel(arg0, "view", "ハブの画面を読み込めません・再接続中", I.I18n.sel(arg0, "http", "ハブがHTTP " ++ arg1 ++ "を返しました・再接続中", "接続が切れました・再接続中")))))))))

