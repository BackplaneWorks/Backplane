    case 251: "\u{fb00}\u{66}\u{66}\u{0}\u{fb01}\u{66}\u{69}\u{0}\u{fb02}\u{66}\u{6c}\u{0}\u{fb03}\u{66}\u{66}\u{69}\u{0}\u{fb04}\u{66}\u{66}\u{6c}\u{0}\u{fb05}\u{73}\u{74}\u{0}\u{fb06}\u{73}\u{74}\u{0}\u{fb13}\u{574}\u{576}\u{0}\u{fb14}\u{574}\u{565}\u{0}\u{fb15}\u{574}\u{56b}\u{0}\u{fb16}\u{57e}\u{576}\u{0}\u{fb17}\u{574}\u{56d}\u{0}\u{fb1d}\u{5d9}\u{0}\u{fb1f}\u{5f2}\u{0}\u{fb2a}\u{5e9}\u{0}\u{fb2b}\u{5e9}\u{0}\u{fb2c}\u{5e9}\u{0}\u{fb2d}\u{5e9}\u{0}\u{fb2e}\u{5d0}\u{0}\u{fb2f}\u{5d0}\u{0}\u{fb30}\u{5d0}\u{0}\u{fb31}\u{5d1}\u{0}\u{fb32}\u{5d2}\u{0}\u{fb33}\u{5d3}\u{0}\u{fb34}\u{5d4}\u{0}\u{fb35}\u{5d5}\u{0}\u{fb36}\u{5d6}\u{0}\u{fb38}\u{5d8}\u{0}\u{fb39}\u{5d9}\u{0}\u{fb3a}\u{5da}\u{0}\u{fb3b}\u{5db}\u{0}\u{fb3c}\u{5dc}\u{0}\u{fb3e}\u{5de}\u{0}\u{fb40}\u{5e0}\u{0}\u{fb41}\u{5e1}\u{0}\u{fb43}\u{5e3}\u{0}\u{fb44}\u{5e4}\u{0}\u{fb46}\u{5e6}\u{0}\u{fb47}\u{5e7}\u{0}\u{fb48}\u{5e8}\u{0}\u{fb49}\u{5e9}\u{0}\u{fb4a}\u{5ea}\u{0}\u{fb4b}\u{5d5}\u{0}\u{fb4c}\u{5d1}\u{0}\u{fb4d}\u{5db}\u{0}\u{fb4e}\u{5e4}\u{0}"
