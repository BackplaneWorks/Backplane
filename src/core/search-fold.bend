    case 48: "\u{304c}\u{304b}\u{0}\u{304e}\u{304d}\u{0}\u{3050}\u{304f}\u{0}\u{3052}\u{3051}\u{0}\u{3054}\u{3053}\u{0}\u{3056}\u{3055}\u{0}\u{3058}\u{3057}\u{0}\u{305a}\u{3059}\u{0}\u{305c}\u{305b}\u{0}\u{305e}\u{305d}\u{0}\u{3060}\u{305f}\u{0}\u{3062}\u{3061}\u{0}\u{3065}\u{3064}\u{0}\u{3067}\u{3066}\u{0}\u{3069}\u{3068}\u{0}\u{3070}\u{306f}\u{0}\u{3071}\u{306f}\u{0}\u{3073}\u{3072}\u{0}\u{3074}\u{3072}\u{0}\u{3076}\u{3075}\u{0}\u{3077}\u{3075}\u{0}\u{3079}\u{3078}\u{0}\u{307a}\u{3078}\u{0}\u{307c}\u{307b}\u{0}\u{307d}\u{307b}\u{0}\u{3094}\u{3046}\u{0}\u{309e}\u{309d}\u{0}\u{30ac}\u{30ab}\u{0}\u{30ae}\u{30ad}\u{0}\u{30b0}\u{30af}\u{0}\u{30b2}\u{30b1}\u{0}\u{30b4}\u{30b3}\u{0}\u{30b6}\u{30b5}\u{0}\u{30b8}\u{30b7}\u{0}\u{30ba}\u{30b9}\u{0}\u{30bc}\u{30bb}\u{0}\u{30be}\u{30bd}\u{0}\u{30c0}\u{30bf}\u{0}\u{30c2}\u{30c1}\u{0}\u{30c5}\u{30c4}\u{0}\u{30c7}\u{30c6}\u{0}\u{30c9}\u{30c8}\u{0}\u{30d0}\u{30cf}\u{0}\u{30d1}\u{30cf}\u{0}\u{30d3}\u{30d2}\u{0}\u{30d4}\u{30d2}\u{0}\u{30d6}\u{30d5}\u{0}\u{30d7}\u{30d5}\u{0}\u{30d9}\u{30d8}\u{0}\u{30da}\u{30d8}\u{0}\u{30dc}\u{30db}\u{0}\u{30dd}\u{30db}\u{0}\u{30f4}\u{30a6}\u{0}\u{30f7}\u{30ef}\u{0}\u{30f8}\u{30f0}\u{0}\u{30f9}\u{30f1}\u{0}\u{30fa}\u{30f2}\u{0}\u{30fe}\u{30fd}\u{0}"
    case 166: "\u{a640}\u{a641}\u{0}\u{a642}\u{a643}\u{0}\u{a644}\u{a645}\u{0}\u{a646}\u{a647}\u{0}\u{a648}\u{a649}\u{0}\u{a64a}\u{a64b}\u{0}\u{a64c}\u{a64d}\u{0}\u{a64e}\u{a64f}\u{0}\u{a650}\u{a651}\u{0}\u{a652}\u{a653}\u{0}\u{a654}\u{a655}\u{0}\u{a656}\u{a657}\u{0}\u{a658}\u{a659}\u{0}\u{a65a}\u{a65b}\u{0}\u{a65c}\u{a65d}\u{0}\u{a65e}\u{a65f}\u{0}\u{a660}\u{a661}\u{0}\u{a662}\u{a663}\u{0}\u{a664}\u{a665}\u{0}\u{a666}\u{a667}\u{0}\u{a668}\u{a669}\u{0}\u{a66a}\u{a66b}\u{0}\u{a66c}\u{a66d}\u{0}\u{a680}\u{a681}\u{0}\u{a682}\u{a683}\u{0}\u{a684}\u{a685}\u{0}\u{a686}\u{a687}\u{0}\u{a688}\u{a689}\u{0}\u{a68a}\u{a68b}\u{0}\u{a68c}\u{a68d}\u{0}\u{a68e}\u{a68f}\u{0}\u{a690}\u{a691}\u{0}\u{a692}\u{a693}\u{0}\u{a694}\u{a695}\u{0}\u{a696}\u{a697}\u{0}\u{a698}\u{a699}\u{0}\u{a69a}\u{a69b}\u{0}"
    case 167: "\u{a722}\u{a723}\u{0}\u{a724}\u{a725}\u{0}\u{a726}\u{a727}\u{0}\u{a728}\u{a729}\u{0}\u{a72a}\u{a72b}\u{0}\u{a72c}\u{a72d}\u{0}\u{a72e}\u{a72f}\u{0}\u{a732}\u{a733}\u{0}\u{a734}\u{a735}\u{0}\u{a736}\u{a737}\u{0}\u{a738}\u{a739}\u{0}\u{a73a}\u{a73b}\u{0}\u{a73c}\u{a73d}\u{0}\u{a73e}\u{a73f}\u{0}\u{a740}\u{a741}\u{0}\u{a742}\u{a743}\u{0}\u{a744}\u{a745}\u{0}\u{a746}\u{a747}\u{0}\u{a748}\u{a749}\u{0}\u{a74a}\u{a74b}\u{0}\u{a74c}\u{a74d}\u{0}\u{a74e}\u{a74f}\u{0}\u{a750}\u{a751}\u{0}\u{a752}\u{a753}\u{0}\u{a754}\u{a755}\u{0}\u{a756}\u{a757}\u{0}\u{a758}\u{a759}\u{0}\u{a75a}\u{a75b}\u{0}\u{a75c}\u{a75d}\u{0}\u{a75e}\u{a75f}\u{0}\u{a760}\u{a761}\u{0}\u{a762}\u{a763}\u{0}\u{a764}\u{a765}\u{0}\u{a766}\u{a767}\u{0}\u{a768}\u{a769}\u{0}\u{a76a}\u{a76b}\u{0}\u{a76c}\u{a76d}\u{0}\u{a76e}\u{a76f}\u{0}\u{a779}\u{a77a}\u{0}\u{a77b}\u{a77c}\u{0}\u{a77d}\u{1d79}\u{0}\u{a77e}\u{a77f}\u{0}\u{a780}\u{a781}\u{0}\u{a782}\u{a783}\u{0}\u{a784}\u{a785}\u{0}\u{a786}\u{a787}\u{0}\u{a78b}\u{a78c}\u{0}\u{a78d}\u{265}\u{0}\u{a790}\u{a791}\u{0}\u{a792}\u{a793}\u{0}\u{a796}\u{a797}\u{0}\u{a798}\u{a799}\u{0}\u{a79a}\u{a79b}\u{0}\u{a79c}\u{a79d}\u{0}\u{a79e}\u{a79f}\u{0}\u{a7a0}\u{a7a1}\u{0}\u{a7a2}\u{a7a3}\u{0}\u{a7a4}\u{a7a5}\u{0}\u{a7a6}\u{a7a7}\u{0}\u{a7a8}\u{a7a9}\u{0}\u{a7aa}\u{266}\u{0}\u{a7ab}\u{25c}\u{0}\u{a7ac}\u{261}\u{0}\u{a7ad}\u{26c}\u{0}\u{a7ae}\u{26a}\u{0}\u{a7b0}\u{29e}\u{0}\u{a7b1}\u{287}\u{0}\u{a7b2}\u{29d}\u{0}\u{a7b3}\u{ab53}\u{0}\u{a7b4}\u{a7b5}\u{0}\u{a7b6}\u{a7b7}\u{0}\u{a7b8}\u{a7b9}\u{0}\u{a7ba}\u{a7bb}\u{0}\u{a7bc}\u{a7bd}\u{0}\u{a7be}\u{a7bf}\u{0}\u{a7c0}\u{a7c1}\u{0}\u{a7c2}\u{a7c3}\u{0}\u{a7c4}\u{a794}\u{0}\u{a7c5}\u{282}\u{0}\u{a7c6}\u{1d8e}\u{0}\u{a7c7}\u{a7c8}\u{0}\u{a7c9}\u{a7ca}\u{0}\u{a7cb}\u{264}\u{0}\u{a7cc}\u{a7cd}\u{0}\u{a7d0}\u{a7d1}\u{0}\u{a7d6}\u{a7d7}\u{0}\u{a7d8}\u{a7d9}\u{0}\u{a7da}\u{a7db}\u{0}\u{a7dc}\u{19b}\u{0}\u{a7f5}\u{a7f6}\u{0}"
    case 171: "\u{ab70}\u{13a0}\u{0}\u{ab71}\u{13a1}\u{0}\u{ab72}\u{13a2}\u{0}\u{ab73}\u{13a3}\u{0}\u{ab74}\u{13a4}\u{0}\u{ab75}\u{13a5}\u{0}\u{ab76}\u{13a6}\u{0}\u{ab77}\u{13a7}\u{0}\u{ab78}\u{13a8}\u{0}\u{ab79}\u{13a9}\u{0}\u{ab7a}\u{13aa}\u{0}\u{ab7b}\u{13ab}\u{0}\u{ab7c}\u{13ac}\u{0}\u{ab7d}\u{13ad}\u{0}\u{ab7e}\u{13ae}\u{0}\u{ab7f}\u{13af}\u{0}\u{ab80}\u{13b0}\u{0}\u{ab81}\u{13b1}\u{0}\u{ab82}\u{13b2}\u{0}\u{ab83}\u{13b3}\u{0}\u{ab84}\u{13b4}\u{0}\u{ab85}\u{13b5}\u{0}\u{ab86}\u{13b6}\u{0}\u{ab87}\u{13b7}\u{0}\u{ab88}\u{13b8}\u{0}\u{ab89}\u{13b9}\u{0}\u{ab8a}\u{13ba}\u{0}\u{ab8b}\u{13bb}\u{0}\u{ab8c}\u{13bc}\u{0}\u{ab8d}\u{13bd}\u{0}\u{ab8e}\u{13be}\u{0}\u{ab8f}\u{13bf}\u{0}\u{ab90}\u{13c0}\u{0}\u{ab91}\u{13c1}\u{0}\u{ab92}\u{13c2}\u{0}\u{ab93}\u{13c3}\u{0}\u{ab94}\u{13c4}\u{0}\u{ab95}\u{13c5}\u{0}\u{ab96}\u{13c6}\u{0}\u{ab97}\u{13c7}\u{0}\u{ab98}\u{13c8}\u{0}\u{ab99}\u{13c9}\u{0}\u{ab9a}\u{13ca}\u{0}\u{ab9b}\u{13cb}\u{0}\u{ab9c}\u{13cc}\u{0}\u{ab9d}\u{13cd}\u{0}\u{ab9e}\u{13ce}\u{0}\u{ab9f}\u{13cf}\u{0}\u{aba0}\u{13d0}\u{0}\u{aba1}\u{13d1}\u{0}\u{aba2}\u{13d2}\u{0}\u{aba3}\u{13d3}\u{0}\u{aba4}\u{13d4}\u{0}\u{aba5}\u{13d5}\u{0}\u{aba6}\u{13d6}\u{0}\u{aba7}\u{13d7}\u{0}\u{aba8}\u{13d8}\u{0}\u{aba9}\u{13d9}\u{0}\u{abaa}\u{13da}\u{0}\u{abab}\u{13db}\u{0}\u{abac}\u{13dc}\u{0}\u{abad}\u{13dd}\u{0}\u{abae}\u{13de}\u{0}\u{abaf}\u{13df}\u{0}\u{abb0}\u{13e0}\u{0}\u{abb1}\u{13e1}\u{0}\u{abb2}\u{13e2}\u{0}\u{abb3}\u{13e3}\u{0}\u{abb4}\u{13e4}\u{0}\u{abb5}\u{13e5}\u{0}\u{abb6}\u{13e6}\u{0}\u{abb7}\u{13e7}\u{0}\u{abb8}\u{13e8}\u{0}\u{abb9}\u{13e9}\u{0}\u{abba}\u{13ea}\u{0}\u{abbb}\u{13eb}\u{0}\u{abbc}\u{13ec}\u{0}\u{abbd}\u{13ed}\u{0}\u{abbe}\u{13ee}\u{0}\u{abbf}\u{13ef}\u{0}"
    case 249: "\u{f900}\u{8c48}\u{0}\u{f901}\u{66f4}\u{0}\u{f902}\u{8eca}\u{0}\u{f903}\u{8cc8}\u{0}\u{f904}\u{6ed1}\u{0}\u{f905}\u{4e32}\u{0}\u{f906}\u{53e5}\u{0}\u{f907}\u{9f9c}\u{0}\u{f908}\u{9f9c}\u{0}\u{f909}\u{5951}\u{0}\u{f90a}\u{91d1}\u{0}\u{f90b}\u{5587}\u{0}\u{f90c}\u{5948}\u{0}\u{f90d}\u{61f6}\u{0}\u{f90e}\u{7669}\u{0}\u{f90f}\u{7f85}\u{0}\u{f910}\u{863f}\u{0}\u{f911}\u{87ba}\u{0}\u{f912}\u{88f8}\u{0}\u{f913}\u{908f}\u{0}\u{f914}\u{6a02}\u{0}\u{f915}\u{6d1b}\u{0}\u{f916}\u{70d9}\u{0}\u{f917}\u{73de}\u{0}\u{f918}\u{843d}\u{0}\u{f919}\u{916a}\u{0}\u{f91a}\u{99f1}\u{0}\u{f91b}\u{4e82}\u{0}\u{f91c}\u{5375}\u{0}\u{f91d}\u{6b04}\u{0}\u{f91e}\u{721b}\u{0}\u{f91f}\u{862d}\u{0}\u{f920}\u{9e1e}\u{0}\u{f921}\u{5d50}\u{0}\u{f922}\u{6feb}\u{0}\u{f923}\u{85cd}\u{0}\u{f924}\u{8964}\u{0}\u{f925}\u{62c9}\u{0}\u{f926}\u{81d8}\u{0}\u{f927}\u{881f}\u{0}\u{f928}\u{5eca}\u{0}\u{f929}\u{6717}\u{0}\u{f92a}\u{6d6a}\u{0}\u{f92b}\u{72fc}\u{0}\u{f92c}\u{90ce}\u{0}\u{f92d}\u{4f86}\u{0}\u{f92e}\u{51b7}\u{0}\u{f92f}\u{52de}\u{0}\u{f930}\u{64c4}\u{0}\u{f931}\u{6ad3}\u{0}\u{f932}\u{7210}\u{0}\u{f933}\u{76e7}\u{0}\u{f934}\u{8001}\u{0}\u{f935}\u{8606}\u{0}\u{f936}\u{865c}\u{0}\u{f937}\u{8def}\u{0}\u{f938}\u{9732}\u{0}\u{f939}\u{9b6f}\u{0}\u{f93a}\u{9dfa}\u{0}\u{f93b}\u{788c}\u{0}\u{f93c}\u{797f}\u{0}\u{f93d}\u{7da0}\u{0}\u{f93e}\u{83c9}\u{0}\u{f93f}\u{9304}\u{0}\u{f940}\u{9e7f}\u{0}\u{f941}\u{8ad6}\u{0}\u{f942}\u{58df}\u{0}\u{f943}\u{5f04}\u{0}\u{f944}\u{7c60}\u{0}\u{f945}\u{807e}\u{0}\u{f946}\u{7262}\u{0}\u{f947}\u{78ca}\u{0}\u{f948}\u{8cc2}\u{0}\u{f949}\u{96f7}\u{0}\u{f94a}\u{58d8}\u{0}\u{f94b}\u{5c62}\u{0}\u{f94c}\u{6a13}\u{0}\u{f94d}\u{6dda}\u{0}\u{f94e}\u{6f0f}\u{0}\u{f94f}\u{7d2f}\u{0}\u{f950}\u{7e37}\u{0}\u{f951}\u{964b}\u{0}\u{f952}\u{52d2}\u{0}\u{f953}\u{808b}\u{0}\u{f954}\u{51dc}\u{0}\u{f955}\u{51cc}\u{0}\u{f956}\u{7a1c}\u{0}\u{f957}\u{7dbe}\u{0}\u{f958}\u{83f1}\u{0}\u{f959}\u{9675}\u{0}\u{f95a}\u{8b80}\u{0}\u{f95b}\u{62cf}\u{0}\u{f95c}\u{6a02}\u{0}\u{f95d}\u{8afe}\u{0}\u{f95e}\u{