#!/bin/sh
# Installs Backplane: { curl -fsSL https://github.com/BackplaneWorks/Backplane/releases/latest/download/install.sh 2>/dev/null || wget -qO- https://github.com/BackplaneWorks/Backplane/releases/latest/download/install.sh; } | sh
#   (curl where there is one, else wget: a stock Ubuntu desktop has only wget, macOS only curl)
#
# The release fills in the version and the sha256 of each archive (release.yml, from deploy/install.sh.in), so this script vouches for what it
# downloads. It lays the release out the way the guard runs and updates it (docs/deploy.md):
#   $BACKPLANE_PREFIX (~/.local/share/backplane)/builds/<tag>/   the unpacked release: backplane-hub, backplane-gpui, backplane (the guard), assets
#   $BACKPLANE_PREFIX/CURRENT                                    the build that runs
#   $BACKPLANE_PREFIX/backplane                                  the guard, outside any build so an update never replaces the program running it
# and links `backplane` (the guard's commands: backplane hub status|restart|rollback...) and `backplane-app` (the desktop app of CURRENT) into
# ~/.local/bin. The desktop app starts its home's hub under the guard. With no desktop app (a server), or with BACKPLANE_START=1, this starts the guard
# itself: home $BACKPLANE_HOME (~/.backplane/hub), port $BACKPLANE_PORT (the first free from 3800). Run again on a machine whose guard is running,
# it hands the new build to that guard, which runs it on probation and goes back if it fails. No sudo, no shell files edited.
# BACKPLANE_ARCHIVE=<file> installs that archive (still checked against its sha256) instead of downloading it.
# Terminal downloads show a progress bar; --quiet or BACKPLANE_QUIET=1 uses plain step results, as does NO_COLOR. Example: curl ... | sh -s -- --quiet.
set -eu

REPO="@REPO@"
VER="@VERSION@"
SHA_LINUX_X64="@SHA_LINUX_X64@"
SHA_LINUX_ARM64="@SHA_LINUX_ARM64@"
SHA_DARWIN_ARM64="@SHA_DARWIN_ARM64@"

# Progress helpers begin. Kept in the generated single-file installer.
# --quiet/BACKPLANE_QUIET and NO_COLOR select plain, one-line step results.
bp_quiet=${BACKPLANE_QUIET:-}
[ "$bp_quiet" = 0 ] && bp_quiet=
for bp_arg in "$@"; do
  case $bp_arg in
    -q|--quiet) bp_quiet=1 ;;
    *) printf 'backplane: unknown option %s (only --quiet)\n' "$bp_arg" >&2; exit 2 ;;
  esac
done
bp_fancy=0
if [ -t 2 ] && [ "${TERM:-dumb}" != dumb ] && [ -z "$bp_quiet" ] && [ -z "${NO_COLOR+x}" ]; then
  bp_fancy=1
fi
bp_step=0 bp_label= bp_task_pid=
bp_esc=$(printf '\033')
bp_begin() {
  bp_step=$((bp_step + 1))
  bp_label=$1
  if [ "$bp_fancy" = 1 ]; then
    printf '\r%s[2K[%s/5] %s ...' "$bp_esc" "$bp_step" "$bp_label" >&2
  fi
}
bp_done() {
  if [ "$bp_fancy" = 1 ]; then
    printf '\r%s[2K%s[32m[%s/5] %s: done%s[0m\n' "$bp_esc" "$bp_esc" "$bp_step" "$bp_label" "$bp_esc" >&2
  else
    printf '[%s/5] %s: done\n' "$bp_step" "$bp_label" >&2
  fi
  bp_label=
}
fail() {
  if [ -n "$bp_label" ]; then
    if [ "$bp_fancy" = 1 ]; then printf '\r%s[2K' "$bp_esc" >&2; fi
    printf '[%s/5] %s: failed\n' "$bp_step" "$bp_label" >&2
  fi
  printf 'backplane: %s\n' "$*" >&2
  exit 1
}
bp_cleanup() {
  if [ -n "$bp_task_pid" ]; then
    kill "$bp_task_pid" 2>/dev/null || :
    wait "$bp_task_pid" 2>/dev/null || :
  fi
  rm -rf "$tmp"
}
# Only temporary archive extraction animates in a captured child. Installation
# and replacement remain synchronous in the foreground, as before.
bp_extract() {
  if [ "$bp_fancy" != 1 ]; then "$@"; return; fi
  rm -f "$tmp/progress.rc"
  (bp_rc=0; "$@" >"$tmp/progress.log" 2>&1 || bp_rc=$?; printf '%s\n' "$bp_rc" >"$tmp/progress.rc") &
  bp_task_pid=$!
  while [ ! -s "$tmp/progress.rc" ]; do
    for bp_frame in '|' '/' '-' '\'; do
      printf '\r%s[2K[%s/5] %s %s' "$bp_esc" "$bp_step" "$bp_label" "$bp_frame" >&2
      sleep 0.1
      [ -s "$tmp/progress.rc" ] && break
    done
  done
  wait "$bp_task_pid" || :
  bp_task_pid=
  cat "$tmp/progress.log" >&2
  return "$(cat "$tmp/progress.rc")"
}
# Progress helpers end.

bp_begin 'Detect platform'
case $(uname -s) in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  *) fail "$(uname -s) is not supported yet (Linux and macOS are)" ;;
esac
case $(uname -m) in
  x86_64|amd64) arch=x64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) fail "$(uname -m) is not supported yet" ;;
esac
case $os-$arch in
  linux-x64) sum=$SHA_LINUX_X64 ;;
  linux-arm64) sum=$SHA_LINUX_ARM64 ;;
  darwin-arm64) sum=$SHA_DARWIN_ARM64 ;;
  *) fail "no build for $os-$arch yet" ;;
esac
[ -n "$sum" ] || fail "this release has no build for $os-$arch"
case $VER in v[0-9]*) ;; *) fail "this installer was not filled in by a release" ;; esac
bp_done

prefix=${BACKPLANE_PREFIX:-$HOME/.local/share/backplane}
bin=${BACKPLANE_BIN:-$HOME/.local/bin}
name="backplane-$VER-$os-$arch-native.tar.gz"
mkdir -p "$prefix/builds" "$bin"
tmp=$(mktemp -d "$prefix/builds/.install.XXXXXX")   # beside the builds, on the same disk: the last step is a rename
trap bp_cleanup 0
trap 'exit 130' 2 15
sha_ok() { # file sum
  if command -v sha256sum >/dev/null 2>&1; then echo "$2  $1" | sha256sum -c - >/dev/null 2>&1; else echo "$2  $1" | shasum -a 256 -c - >/dev/null 2>&1; fi
}
# curl, else wget (a stock Ubuntu desktop has wget and no curl)
if command -v curl >/dev/null 2>&1; then bp_get=curl; elif command -v wget >/dev/null 2>&1; then bp_get=wget; else bp_get=; fi
bp_begin 'Download and verify release'
if [ -n "${BACKPLANE_ARCHIVE:-}" ]; then
  cp "$BACKPLANE_ARCHIVE" "$tmp/$name" || fail "cannot read $BACKPLANE_ARCHIVE"
else
  url="https://github.com/$REPO/releases/download/$VER/$name"
  [ -n "$bp_get" ] || fail "curl or wget is needed to download $url (sudo apt install curl)"
  echo "downloading $url"
  if [ "$bp_get" = curl ]; then
    if [ "$bp_fancy" = 1 ]; then curl --proto '=https' --tlsv1.2 -fL --progress-bar -o "$tmp/$name" "$url" || fail "download failed: $url"
    else curl --proto '=https' --tlsv1.2 -fsSL -o "$tmp/$name" "$url" || fail "download failed: $url"; fi
  else
    if [ "$bp_fancy" = 1 ]; then wget -q --show-progress --https-only -O "$tmp/$name" "$url" || fail "download failed: $url"
    else wget -q --https-only -O "$tmp/$name" "$url" || fail "download failed: $url"; fi
  fi
fi
sha_ok "$tmp/$name" "$sum" || fail "$name does not match its sha256; not installed"
bp_done

bp_begin 'Unpack release'
mkdir "$tmp/build"
bp_extract tar -xzf "$tmp/$name" -C "$tmp/build" --no-same-owner || fail "could not unpack $name; not installed"
for f in backplane-hub backplane; do [ -x "$tmp/build/$f" ] || fail "this release has no $f for $os-$arch; not installed"; done
if [ -z "${BACKPLANE_NO_DESKTOP_APP:-}" ] && [ ! -x "$tmp/build/backplane-gpui" ]; then fail "this release has no desktop app for $os-$arch (BACKPLANE_NO_DESKTOP_APP=1 installs the hub alone)"; fi
bp_done

bp_begin 'Install'
# a build is only ever made whole, by one rename; one already there is the same release (its sha256 was checked when it came)
[ -d "$prefix/builds/$VER" ] || mv "$tmp/build" "$prefix/builds/$VER"
# the guard: replaced beside and renamed over, so a running guard keeps the program it started with
cp "$prefix/builds/$VER/backplane" "$tmp/guard" && chmod 755 "$tmp/guard" && mv -f "$tmp/guard" "$prefix/backplane"
ln -sf "$prefix/backplane" "$bin/backplane"
printf '#!/bin/sh\n# the desktop app of the build the guard runs now\nP=%s\nexec "$P/builds/$(cat "$P/CURRENT")/backplane-gpui" "$@"\n' "'$(printf '%s' "$prefix" | sed "s/'/'\\\\''/g")'" > "$tmp/app"
chmod 755 "$tmp/app" && mv -f "$tmp/app" "$bin/backplane-app"
# Linux: the applications menu entry and its icon (BACKPLANE_NO_DESKTOP=1 skips them). Exec names the launcher by its full path, since a desktop
# session's PATH often lacks ~/.local/bin; the path is quoted for the desktop file (escapes, then %), never handed to a shell as code.
menu=
icons="$prefix/builds/$VER/assets/icon"
if [ "$os" = linux ] && [ -z "${BACKPLANE_NO_DESKTOP:-}" ] && [ -z "${BACKPLANE_NO_DESKTOP_APP:-}" ]; then
  data=${XDG_DATA_HOME:-$HOME/.local/share}
  mkdir -p "$data/applications" "$data/icons/hicolor/scalable/apps"
  BACKPLANE_DESKTOP_EXEC="$bin/backplane-app" awk '
    function quote(path, quoted, i, c) {
      quoted = "\""
      for (i = 1; i <= length(path); i++) {
        c = substr(path, i, 1)
        if (c == "\\") quoted = quoted "\\\\\\\\"
        else if (c == "\"" || c == "$" || c == sprintf("%c", 96)) quoted = quoted "\\\\" c
        else if (c == "%") quoted = quoted "%%"
        else if (c == "\n") quoted = quoted "\\n"
        else if (c == "\r") quoted = quoted "\\r"
        else if (c == "\t") quoted = quoted "\\t"
        else quoted = quoted c
      }
      return quoted "\""
    }
    BEGIN {
      print "[Desktop Entry]"; print "Type=Application"; print "Name=Backplane"; print "Comment=Agents for electronics and mechanical design"
      print "Icon=backplane-desktop"; print "Terminal=false"; print "Categories=Development;Electronics;"
      print "Exec=/bin/sh -c " quote("exec \"$0\"") " " quote(ENVIRON["BACKPLANE_DESKTOP_EXEC"])
    }' > "$data/applications/backplane.desktop"
  [ -f "$icons/backplane-desktop.svg" ] && cp -f "$icons/backplane-desktop.svg" "$data/icons/hicolor/scalable/apps/"
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
  menu=1
fi
bp_done

bp_begin 'Start'
# the command to give: its full path while ~/.local/bin is not on PATH (a fresh install: Ubuntu adds it only at the next login)
case ":$PATH:" in *":$bin:"*) app=backplane-app ;; *) app="$bin/backplane-app" ;; esac
home=${BACKPLANE_HOME:-}
if [ -z "$home" ]; then case $os in darwin) home="$HOME/Library/Application Support/Backplane/hub" ;; *) home="$HOME/.backplane/hub" ;; esac; fi
running=
if [ -f "$home/guard/lock" ] && ! "$prefix/backplane" hub status --home "$home" 2>/dev/null | grep -q 'No guard is running'; then running=1; fi
how=
if [ -n "$running" ]; then
  # the guard that runs this home takes the new build on probation: one failure and it goes back (docs/deploy.md)
  if [ "$(cat "$prefix/CURRENT" 2>/dev/null)" = "$VER" ]; then how="Backplane $VER already runs in $home."
  else said=$("$prefix/backplane" hub update "$VER" --home "$home" 2>&1) || fail "the guard of $home did not take $VER: $(printf '%s' "$said" | tail -1)"
    how="The guard of $home is moving to $VER; if it fails its health check, it goes back."; fi
else
  printf '%s\n' "$VER" > "$tmp/current" && mv -f "$tmp/current" "$prefix/CURRENT"
  if [ -n "${BACKPLANE_START:-}" ] || [ -n "${BACKPLANE_NO_DESKTOP_APP:-}" ]; then
    port=${BACKPLANE_PORT:-}
    # a port is taken when anything answers on it (wget: 4 is a network failure, any other code had an answer)
    taken() { if [ "$bp_get" = curl ]; then curl -s -m1 -o /dev/null "http://127.0.0.1:$1/"; else wget -q -T1 -t1 -O /dev/null "http://127.0.0.1:$1/"; [ $? != 4 ]; fi; }
    if [ -z "$port" ]; then p=3800; while [ $p -le 3899 ]; do taken $p || { port=$p; break; }; p=$((p+1)); done; fi
    [ -n "$port" ] || fail "no free port between 3800 and 3899 (set BACKPLANE_PORT)"
    mkdir -p "$home"
    nohup "$prefix/backplane" hub run --home "$home" --port "$port" --builds "$prefix" --default --log "$home/hub.log" -- --foreground ${BACKPLANE_HUB_ARGS:-} >> "$home/guard.log" 2>&1 < /dev/null &
    how="The guard runs the hub of $home on port $port (backplane hub status)."
  else how="Run: $app (it starts its hub under the guard)."; fi
fi
bp_done
echo
echo "  Backplane $VER is installed. $how"
[ -n "$menu" ] && echo "  It is also in your applications menu."
case ":$PATH:" in
  *":$bin:"*) ;;
  *) echo "  ($bin is not on your PATH yet: many systems add it at the next login; or add it yourself)" ;;
esac
