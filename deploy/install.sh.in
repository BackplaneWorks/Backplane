#!/bin/sh
# Installs Backplane: curl -fsSL https://github.com/i2cjak/Backplane/releases/latest/download/install.sh | sh
#
# The release fills in the version and the sha256 of each archive
# (scripts/release-classic.sh), so this script vouches for what it downloads.
# It unpacks the hub, its web client and the `backplane` launcher into
# $BACKPLANE_PREFIX (~/.local/share/backplane), the desktop app into its
# desktop/ folder (BACKPLANE_NO_DESKTOP_APP=1 skips it: a hub-only install),
# and links the commands into ~/.local/bin. No sudo, no shell files edited.
set -eu

REPO="i2cjak/Backplane"
VER="@VERSION@"
SHA_LINUX_X64="@SHA_LINUX_X64@"
SHA_LINUX_ARM64="@SHA_LINUX_ARM64@"
SHA_DARWIN_ARM64="@SHA_DARWIN_ARM64@"

fail() { printf 'backplane: %s\n' "$*" >&2; exit 1; }

case $(uname -s) in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  *) fail "$(uname -s) is not supported yet (Linux and macOS are)" ;;
esac
case $(uname -m) in
  x86_64|amd64) arch=x64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) fail "$(uname -m) is not supported yet" ;;
esac
case $os-$arch in
  linux-x64) sum=$SHA_LINUX_X64 ;;
  linux-arm64) sum=$SHA_LINUX_ARM64 ;;
  darwin-arm64) sum=$SHA_DARWIN_ARM64 ;;
  *) fail "no build for $os-$arch yet" ;;
esac
[ -n "$sum" ] || fail "this release has no build for $os-$arch"

prefix=${BACKPLANE_PREFIX:-$HOME/.local/share/backplane}
bin=${BACKPLANE_BIN:-$HOME/.local/bin}
# the hub, its web client, the launcher and the desktop app, in one archive
# checked before anything is replaced
name="backplane-$VER-classic-$os-$arch.tar.gz"
mkdir -p "$prefix" "$bin"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
fetch() {
  url="https://github.com/$REPO/releases/download/$VER/$1"
  echo "downloading $url"
  curl --proto '=https' --tlsv1.2 -fsSL -o "$tmp/$1" "$url" || fail "download failed: $url"
  if command -v sha256sum >/dev/null 2>&1; then
    echo "$2  $tmp/$1" | sha256sum -c - >/dev/null 2>&1 || fail "$1 does not match its sha256; not installed"
  else
    echo "$2  $tmp/$1" | shasum -a 256 -c - >/dev/null 2>&1 || fail "$1 does not match its sha256; not installed"
  fi
}
fetch "$name" "$sum"
tar -xzf "$tmp/$name" -C "$tmp"
app=
if [ -z "${BACKPLANE_NO_DESKTOP_APP:-}" ]; then
  [ -d "$tmp/backplane-$os-$arch/desktop" ] || fail "this release has no desktop app for $os-$arch (BACKPLANE_NO_DESKTOP_APP=1 installs the hub alone)"
  app=1
fi
BACKPLANE_INSTALL_DESKTOP=$app sh "$tmp/backplane-$os-$arch/install-release.sh" "$tmp/backplane-$os-$arch" "$prefix"
ln -sf "$prefix/backplane" "$bin/backplane"
ln -sf "$prefix/backplane-serve" "$bin/backplane-serve"
# the applications menu entry and its icon (BACKPLANE_NO_DESKTOP=1 skips
# them); Exec names the link itself, since a desktop session's PATH often
# lacks ~/.local/bin
menu=
pkg="$tmp/backplane-$os-$arch"
if [ "$os" = linux ] && [ -z "${BACKPLANE_NO_DESKTOP:-}" ] && [ -f "$pkg/backplane.desktop" ]; then
  data=${XDG_DATA_HOME:-$HOME/.local/share}
  mkdir -p "$data/applications" "$data/icons/hicolor/scalable/apps" "$data/icons/hicolor/256x256/apps"
  # Exec has desktop-string escaping followed by quoting and percent expansion.
  # Pass the path as an argument to a fixed exec command, never as shell code
  # or a sed replacement. GIO checks the command before expanding literal %%,
  # so a percent-bearing installation path cannot be the first Exec token.
  BACKPLANE_DESKTOP_EXEC="$bin/backplane" awk '
    function quote(path, quoted, i, c) {
      quoted = "\""
      for (i = 1; i <= length(path); i++) {
        c = substr(path, i, 1)
        if (c == "\\") quoted = quoted "\\\\\\\\"
        else if (c == "\"" || c == "$" || c == sprintf("%c", 96)) quoted = quoted "\\\\" c
        else if (c == "%") quoted = quoted "%%"
        else if (c == "\n") quoted = quoted "\\n"
        else if (c == "\r") quoted = quoted "\\r"
        else if (c == "\t") quoted = quoted "\\t"
        else quoted = quoted c
      }
      return quoted "\""
    }
    /^Exec=/ {
      print "Exec=/bin/sh -c " quote("exec \"$0\"") " " quote(ENVIRON["BACKPLANE_DESKTOP_EXEC"])
      next
    }
    { print }
  ' "$pkg/backplane.desktop" > "$data/applications/backplane.desktop"
  [ -f "$pkg/icon/backplane-desktop.svg" ] && cp -f "$pkg/icon/backplane-desktop.svg" "$data/icons/hicolor/scalable/apps/"
  [ -f "$pkg/icon/backplane-desktop-256.png" ] && cp -f "$pkg/icon/backplane-desktop-256.png" "$data/icons/hicolor/256x256/apps/backplane-desktop.png"
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t "$data/icons/hicolor" >/dev/null 2>&1 || true
  menu=1
fi
# Linux: the desktop app's sandbox needs user namespaces or a root-owned
# chrome-sandbox (Ubuntu 23.10+ restricts namespaces); say how, never skip it
sandbox_fix=
if [ "$os" = linux ] && [ -n "$app" ]; then
  helper="$prefix/desktop/runtime/chrome-sandbox"
  if ! { command -v unshare >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1; } \
     && [ "$(stat -c '%u:%g:%a' "$helper" 2>/dev/null)" != "0:0:4755" ]; then
    q=$(printf '%s' "$helper" | sed "s/'/'\\\\''/g")
    sandbox_fix="sudo chown root:root '$q' && sudo chmod 4755 '$q'"
  fi
fi
echo
echo "  Backplane $VER is installed. Run: backplane"
if [ -n "$sandbox_fix" ]; then
  echo "  The desktop app needs its sandbox set up once on this system; run:"
  echo "    $sandbox_fix"
fi
[ -n "$menu" ] && echo "  It is also in your applications menu."
case ":$PATH:" in
  *":$bin:"*) ;;
  *) echo "  (add $bin to your PATH)" ;;
esac
