<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- a silent push clears a notification dealt with on another device -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- the hub is reached over the tailnet (WireGuard), as plain ws:// -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- pairing by QR code: the camera reads the code Settings shows -->
	<key>NSCameraUsageDescription</key>
	<string>@NSCameraUsageDescription@</string>
	<!-- dictation: the composer's mic records while the person dictates -->
	<key>NSMicrophoneUsageDescription</key>
	<string>@NSMicrophoneUsageDescription@</string>
	<!-- Save to Photos: a picture in a thread, long-pressed or from its full view -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>@NSPhotoLibraryAddUsageDescription@</string>
	<!-- a picture handed over by another app (Open in / Share, Files): it waits in the composer of the thread that is open -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- a pairing link: backplane://pair?url=http://host:3787/%23token=... -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.backplane.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<!-- ProMotion: the board viewer draws at up to 120 Hz -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
