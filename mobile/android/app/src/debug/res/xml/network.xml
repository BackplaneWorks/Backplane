<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (this source set overrides src/main/res/xml/network.xml): the release policy, plus plain http to the
     emulator's host (10.0.2.2) and the device itself, so the phone checks reach a local hub (scripts/mobile/data-hub.sh, test/pad/pad_android.sh).
     Release builds never see this file and keep cleartext to the tailnet hub only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">desktop.tail9e0cf2.ts.net</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
