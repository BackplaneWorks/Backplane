<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (this source set overrides src/main/res/xml/network.xml). It is the release policy, plain http to any hub,
     which already covers the emulator's host (10.0.2.2) and the device itself, so the phone checks reach a local hub
     (scripts/mobile/data-hub.sh, test/pad/pad_android.sh). Kept as its own file so a debug-only rule has a place to go. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
