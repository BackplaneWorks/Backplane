{
  "name": "backplane-ci-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --config oxlint.json --deny correctness --deny suspicious --deny-warnings",
    "format:check": "oxfmt --check",
    "typecheck:step2glb": "tsc --project ../step2glb/tsconfig.json --typeRoots ./node_modules/@types",
    "test": "node test.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  }
}
