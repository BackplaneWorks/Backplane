+          const prior=markers[markers.length-1];
+          if(prior?.kind==='unsafe') {prior.kind='def';prior.name=definition[1];prior.unsafe=true;}
+          else markers.push({start:i,end:0,kind:'def',name:definition[1]});
+        } else if(unsafe) markers.push({start:i,end:0,kind:unsafe[1]?'def':'unsafe',name:unsafe[1],unsafe:true});
+        else if(kind) markers.push({start:i,end:0,kind:kind[1]});
+        atLine=false;
+      }
+      if(c==='\n')atLine=true;
+    }
+    markers.forEach((marker,i)=>marker.end=markers[i+1]?.start ?? source.length);
+    const recipes=new Map(markers.filter(m=>m.kind==='def' && m.name).map(m=>[ns?ns+':'+m.name:m.name!,m]));
+    const entries=names.map(name=>({name,header:this.sourceHeader(book.tlds[name]),recipe:recipes.get(name)}));
+    const capsule={format:'bend-source-bodies-1',store:this.identity,source,dir:path.dirname(file)+'/',ns,
+      al:{...parsed.al},seed,entries};
+    const key=this.put(capsule);
+    for(let index=0;index<entries.length;index++) {
+      const {name,header,recipe}=entries[index];
+      if(header.$==='Def' && header.filled && !header.i && recipe!==undefined) {
+        this.sourceRecipes.set(book.tlds[name],{key,index}); this.sourceBodies++;
+      }
+    }
+  }
+
+  private sourceCapsule(key:string): {raw:any;tlds:Bend.Book['tlds'];ctrs:Bend.Book['ctrs'];bytes:number} {
+    const hit=this.sourceCapsules.get(key);
+    if(hit!==undefined) {
+      // Warm hit: the decoded copy is reused, but its backing record is re-hashed and
+      // bounds-checked exactly as a cold read would be, so a changed, truncated or
+      // missing record still fails closed. Only deserialize and header rebuild are skipped.
+      this.record(key);this.sourceCapsuleRevalidations++;
+      this.sourceCapsules.delete(key);this.sourceCapsules.set(key,hit);this.sourceCapsuleHits++;
+      return hit;
+    }
+    const loaded=this.get(key),raw=loaded.value;
+    if(raw?.format!=='bend-source-bodies-1' || raw.store!==this.identity)throw new Error('source recipe belongs to another process store');
+    this.sourceCapsuleReads++;
+    const tlds:Bend.Book['tlds']=Object.create(null),ctrs:Bend.Book['ctrs']=Object.create(null);
+    const header=(raw:any):Bend.TLD=> {
+      const out={...raw} as any;delete out.filled;
+      if(out.$==='Def')out.v=raw.filled ? Object.freeze(Bend.Rfl()) : null;
+      Object.defineProperty(out,'T',{get:priorSourceType});
+      return Object.freeze(out);
+    };
+    for(const [name,value] of raw.seed.tlds)tlds[name]=header(value);
+    for(const [name,value] of raw.seed.ctrs)ctrs[name]=Object.freeze({...value}) as Bend.Ctr;
+    // Read-only prior headers are shared, never the parser's writable table.
+    // A per-replay prototype view gives exact `in`/lookup semantics while the
+    // unchanged parse_def writes only its fresh declaration in the own table.
+    for(const entry of raw.entries)entry.parsedHeader=header(entry.header);
+    Object.freeze(tlds);Object.freeze(ctrs);
+    const value={raw,tlds,ctrs,bytes:loaded.bytes*8};
+    const limit=32*1024**2;
+    if(value.bytes<=limit) {
+      this.sourceCapsules.set(key,value);this.sourceCapsuleBytes+=value.bytes;
+      while(this.sourceCapsuleBytes>limit) {
+        const oldest=this.sourceCapsules.keys().next().value!;
+        this.sourceCapsuleBytes-=this.sourceCapsules.get(oldest)!.bytes;this.sourceCapsules.delete(oldest);
+      }
+    }
+    return value;
+  }
+
+  private replayBody(key:string,index:number): Bend.HTerm {
+    const id='V:'+key+':'+index;
+    const alive=this.sourceLive.get(id)?.deref();
+    if(alive!==undefined)return alive as Bend.HTerm;
+    const cached=this.cached(id);if(cached!==undefined)return cached.value as Bend.HTerm;
+    const capsule=this.sourceCapsule(key),raw=capsule.raw;
+    const entry=raw.entries[index];
+    if(!entry?.recipe || entry.header.$!=='Def' || !entry.header.filled || entry.header.i)throw new Error('invalid source body recipe');
+    const book=Bend.book_nil();
+    book.tlds=Object.create(capsule.tlds);book.ctrs=Object.create(capsule.ctrs);
+    for(const prior of raw.entries.slice(0,index)) {
+      book.tlds[prior.name]=prior.parsedHeader;
+      if(prior.header.$==='ADT')for(const c of prior.header.c)book.ctrs[c.k]=c as Bend.Ctr;
+    }
+    const parser:Bend.Parse={book,dir:raw.dir,str:raw.source,ns:raw.ns,al:{...raw.al},
+      pos:entry.recipe.start,stk:[],frs:0};
+    let unsafe=false;
+    if(Bend.parse_take(parser,'@')) {if(!Bend.parse_word(parser,'unsafe'))throw new Error('source recipe decorator changed');unsafe=true;}
+    if(unsafe!==!!entry.recipe.unsafe || !Bend.parse_word(parser,'def'))throw new Error('source recipe header changed');
+    Bend.parse_def(parser,unsafe);Bend.parse_skip(parser);
+    if(parser.pos!==entry.recipe.end || book.order.length!==1 || book.order[0]!==entry.name)throw new Error('source recipe declaration boundary changed');
+    const def=book.tlds[entry.name];
+    if(def.$!=='Def' || def.v===null || def.i || def.n!==entry.header.n || def.x!==entry.header.x
+      || def.m!==entry.header.m || !!def.u!==!!entry.header.u)throw new Error('source recipe declaration metadata changed');
+    const value=def.v;
+    Bend.parse_close(parser,0);
+    // Public File fields keep exact source/spans. The temporary parser's table
+    // must not keep every preceding declaration alive through one returned body.
+    delete (parser as Partial<Bend.Parse>).book;
+    this.sourceReplays++;
+    this.sourceLive.set(id,new WeakRef(value));
+    this.remember(id,{value,bytes:Math.max(1,entry.recipe.end-entry.recipe.start)*32});
+    return value;
+  }
+
+  private retainBody(target: object, value: Bend.HTerm | null, recipe?:{key:string;index:number}): void {
+    if(recipe!==undefined && value!==null) {
+      let assigned=false,override:Bend.HTerm|null=null;
+      Object.defineProperty(target,'v',{enumerable:false,configurable:true,
+        get:()=>assigned?override:this.replayBody(recipe.key,recipe.index),
+        set:v=>{assigned=true;override=v;bodies.set(target,v!==null);}});
+      return;
+    }
+    // Retain the parser's exact higher-order body. Re-lowering its branching
+    // closures can expand a small source DAG into a huge tree. Checked results
+    // (e) are already lower terms and can be spilled without that conversion.
+    let body = value;
+    Object.defineProperty(target, 'v', { enumerable: false, configurable: true,
+      get: () => body,
+      set: value => { body = value; bodies.set(target, value !== null); },
+    });
+    if (value?.s !== undefined) this.parsedFiles.add(value.s.file);
+  }
+
+  // A separate activation cannot retain field()'s original full term through
+  // the accessor closure, even before the JS engine optimizes that closure.
+  private attach(target: object, name: string, key: string | null,
+    absent: null | undefined, higher: boolean): void {
+    let assigned = false;
+    let override: unknown;
+    Object.defineProperty(target, name, {
+      // book_valid makes temporary bodiless prefix placeholders by spreading a
+      // Def. The prefix is restored before any new event checks. Do not hydrate
+      // every already-checked T/v/e merely to make those temporary placeholders.
+      enumerable: false, configurable: true,
+      get: () => assigned ? override : key === null ? absent : this.read(key, higher),
+      set: value => {
+        assigned = true;
+        override = value;
+        if (name === "v") bodies.set(target, value !== null);
+        if (name === "e") save_checked_refs(target, value);
+      },
+    });
+  }
+
+  private replaceOne(book: Bend.Book, name: string): void {
+    {
+      const original = book.tlds[name];
+      if (this.replaced.has(original)) return;
+      if (process.env.BP_COMPILER_SPILL_PROFILE === '1') profile('spill:start', { name });
+      const { T, ...metadata } = original;
+      let next: Bend.TLD;
+      if (original.$ === "Def") {
+        const { v, e, ...flags } = metadata as Bend.Def;
+        next = flags as Bend.Def;
+        bodies.set(next, original.v !== null);
+        this.interface(next, T);
+        if (process.env.BP_COMPILER_SPILL_PROFILE === '1') profile('spill:body', { name });
+        const recipe=this.sourceRecipes.get(original);
+        this.retainBody(next, original.v,recipe);
+        if(recipe!==undefined)delete (original as Partial<Bend.Def>).v;
+        if (process.env.BP_COMPILER_SPILL_PROFILE === '1') profile('spill:result', { name });
+        if (original.e !== undefined) {
+          if (this.discardResults) {
+            save_checked_refs(next, original.e);
+            // The unchanged checker accepted the entire event group. Its e
+            // result is only emitter IR; proofs and later checking use T/v.
+            // No emit/run/BendTT CLI path requests this storage mode.
+            delete original.e;
+            Object.defineProperty(next, 'e', { enumerable:false, configurable:true,
+              get: () => { throw new Error('emitter IR not retained for check-only book'); },
+              set: value => save_checked_refs(next, value),
+            });
+          } else {
+            this.field(next, "e", original.e, false);
+            // Only after the accepted result is durably written by hash. Old
+            // prefix/future tables may still reference this obsolete Def; no
+            // checker operation consults its emitter IR. Its exact T/v remain.
+            delete original.e;
+          }
+        }
+      } else {
+        const { c, ...flags } = metadata as Bend.ADT;
+        const cs = original.c.map(ctr => {
+          const fresh = { k: ctr.k, n: ctr.n } as Bend.Ctr;
+          this.interface(fresh, ctr.T);
+          book.ctrs[ctr.k] = fresh;
+          return fresh;
+        });
+        next = { ...flags, c: cs } as Bend.ADT;
+        this.interface(next, T);
+      }
+      book.tlds[name] = next;
+      this.replaced.add(next);
+      if (process.env.BP_COMPILER_SPILL_PROFILE === '1') profile('spill:end', {
+        name, stored_bytes: this.bytes, retained_interfaces: this.interfaces.length,
+        identity_cache_entries:this.interfaceIds.size, open_variable_handles:this.openVariables.length,
+      });
+    }
+  }
+
+  replace(book: Bend.Book, names: string[]): void {
+    let collectedAt=process.memoryUsage().rss;
+    for (const name of names) {
+      // Separate activation: destructuring temporaries from one large e are
+      // unreachable before collecting the next accepted definition.
+      this.replaceOne(book,name);
+      const rss=process.memoryUsage().rss;
+      if (rss>1536*1024**2 && rss>collectedAt+128*1024**2) {
+        Bun.gc(true); collectedAt=process.memoryUsage().rss;
+      }
+    }
+    this.detachParsedFiles();
+  }
+
+  clear(): void {
+    this.loaded.clear();
+    this.loadedBytes = 0;
+    this.sourceCapsules.clear();this.sourceCapsuleBytes=0;
+  }
+}
