#!/bin/bash
# bp-nitro: the Nitro Sandboxes on this EC2 parent instance, for Backplane (native/host/src/sandbox/nitro.rs drives it over SSH; docs/NITRO-SANDBOXES.md).
# Runs as root on the parent (AL2023, kernel6.18 >= 6.18.51, Nitro Enclaves on, a memory pool reserved at boot, Firecracker >= 1.18 in /usr/local/bin).
#   bp-nitro status                                  the pools: vCPUs, slots, free pool memory, as JSON
#   bp-nitro list                                    the sandboxes running here, as JSON
#   bp-nitro up NAME IDX DISK_GIB CFG_B64 NFT_B64 [--slots=N]
#                                                    start sandbox NAME with the Firecracker config and nft rules the hub made; waits for its agent
#                                                    --no-wait: return once it started (an attested one waits for `secret`, then `wait`)
#   bp-nitro wait NAME                               until its agent answers; prints the boot time
#   bp-nitro down NAME [--purge]                     stop it (its work disk stays for the next job unless --purge)
#   bp-nitro pipe NAME CMD...                        CMD in the sandbox on this stdin/stdout (rsync -e, through scripts/nitro-ssh.sh)
#   bp-nitro run NAME CWD_B64 ARGV_B64 ENV_B64       a command in /work/src/CWD: its stdout, stderr and exit code
#   bp-nitro prune NAME                              delete what /work/.bp/list does not name from /work/src
#   bp-nitro secret NAME BLOB.enc KEY_ARN            release a KMS secret to an attested sandbox (it never exists here in the clear)
set -u
ROOT=/var/lib/bp-nitro; IMG=$ROOT/img; SYS=/sys/class/misc/nitro_enclaves; HERE=$(cd "$(dirname "$0")" && pwd); VS="python3 -I $HERE/bp-vsock.py"
die() { echo "bp-nitro: $*" >&2; exit 1; }
num() { cat "$1" 2>/dev/null | head -1 | tr -dc '0-9'; }
# a cpu list ("2-7,10") or a count, as a count
cpus() { local v; v=$(cat "$1" 2>/dev/null) || { echo 0; return; }; case "$v" in *-*|*,*) python3 -I -c 'import sys;print(sum((lambda a:int(a[-1])-int(a[0])+1)(r.split("-")) for r in sys.argv[1].strip().split(",") if r))' "$v";; *) echo "${v//[!0-9]/}";; esac; }
alive() { local p; p=$(cat "$ROOT/$1/fc.pid" 2>/dev/null) && kill -0 "$p" 2>/dev/null; }
ok_name() { case "$1" in ""|*[!a-z0-9-]*) die "bad name: $1";; esac; }
cmd=${1:-status}; shift || true
case "$cmd" in
  status)
    m=$(num $SYS/mem_pool/free); [ -n "$m" ] && [ "$m" -gt 100000000 ] && m=$((m / 1048576))   # bytes or MiB
    used=0; for d in "$ROOT"/*/; do n=$(basename "$d"); [ "$n" = img ] && continue; alive "$n" && used=$((used + $(python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1]))["machine-config"]["vcpu_count"])' "$d/cfg.json"))); done
    printf '{"vcpus":%s,"threads_per_core":%s,"slots":%s,"slots_total":%s,"slots_in_use":%s,"mem_free_mib":%s,"cpu_free":%s,"vcpus_in_use":%s}\n' \
      "$(nproc --all)" "$(lscpu | awk -F: '/Thread\(s\) per core/{gsub(/ /,"",$2);print $2}')" "$(num $SYS/pcie_slots)" "$(num $SYS/pcie_slots_total)" \
      "$(num $SYS/pcie_slots_in_use)" "${m:-0}" "$(cpus $SYS/cpu_pool/free)" "$used" ;;
  list)
    s=""; for d in "$ROOT"/*/; do n=$(basename "$d"); [ "$n" = img ] && continue; alive "$n" || continue
      s+="${s:+,}{\"name\":\"$n\",\"idx\":$(cat "$d/idx")}"; done; echo "{\"sandboxes\":[${s}]}" ;;
  up)
    name=$1 idx=$2 disk=$3 cfg=$4 nft=$5; ok_name "$name"; case "$idx$disk" in *[!0-9]*) die "bad number";; esac; shift 5
    wait=1; for a in "$@"; do case "$a" in --no-wait) wait=;; --slots=*) n=${a#--slots=}; [ "$(num $SYS/pcie_slots)" -lt "$n" ] && { echo "$n" > $SYS/pcie_slots || die "cannot raise the slots to $n"; };; esac; done
    alive "$name" && die "$name is running"
    d=$ROOT/$name; mkdir -p "$d"; echo "$idx" > "$d/idx"; echo "$cfg" | base64 -d > "$d/cfg.json" || die "bad config"
    [ -f "$d/work.img" ] || { truncate -s "${disk}G" "$d/work.img" && mkfs.ext4 -q -F -E root_owner=1000:1000 "$d/work.img" || die "cannot make the work disk"; }
    tap=bpn$idx; ip link del "$tap" 2>/dev/null; nft delete table ip "bp_nitro_$idx" 2>/dev/null
    if [ "$nft" != - ]; then
      up=$(ip route show default | awk '{print $5; exit}')
      gw=$(python3 -I -c 'import sys;b=int(sys.argv[1])*4+1;print("10.250.%d.%d"%(b>>8,b&255))' "$idx")
      ip tuntap add dev "$tap" mode tap && ip addr add "$gw/30" dev "$tap" && ip link set "$tap" up || die "cannot make $tap"
      sysctl -qw net.ipv4.ip_forward=1
      echo "$nft" | base64 -d | sed "s/@UPLINK@/$up/g" | nft -f - || die "cannot load the rules of $tap"
    fi
    rm -f "$d/v.sock" "$d"/v.sock_* "$d/api.sock"; date +%s%N > "$d/t0"
    setsid firecracker --api-sock "$d/api.sock" --config-file "$d/cfg.json" > "$d/fc.log" 2>&1 < /dev/null & echo $! > "$d/fc.pid"
    # an attested sandbox waits for its secret (bp-nitro secret) before its agent starts: then the caller waits after that
    [ -z "$wait" ] && { echo "{\"name\":\"$name\",\"idx\":$idx}"; exit 0; }
    exec "$0" wait "$name" ;;
  wait)
    name=$1; ok_name "$name"; d=$ROOT/$name; idx=$(cat "$d/idx"); t0=$(cat "$d/t0")
    for _ in $(seq 1 600); do
      alive "$name" || die "$name stopped while booting: $(tail -3 "$d/fc.log" | tr '\n' ' ')"
      $VS "$d/v.sock" 5000 ping > /dev/null 2>&1 && { echo "{\"name\":\"$name\",\"idx\":$idx,\"boot_ms\":$(( ($(date +%s%N) - t0) / 1000000 ))}"; exit 0; }
      sleep 0.2; done
    kill "$(cat "$d/fc.pid")" 2>/dev/null; die "$name's agent never answered (fc.log: $(tail -3 "$d/fc.log" | tr '\n' ' '))" ;;
  down)
    name=$1; ok_name "$name"; d=$ROOT/$name; p=$(cat "$d/fc.pid" 2>/dev/null)
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then kill -TERM "$p"; for _ in $(seq 1 50); do kill -0 "$p" 2>/dev/null || break; sleep 0.1; done; kill -KILL "$p" 2>/dev/null; fi
    idx=$(cat "$d/idx" 2>/dev/null); [ -n "$idx" ] && { ip link del "bpn$idx" 2>/dev/null; nft delete table ip "bp_nitro_$idx" 2>/dev/null; }
    rm -f "$d/fc.pid" "$d/v.sock" "$d"/v.sock_* "$d/api.sock"; [ "${2:-}" = --purge ] && rm -rf "$d"; echo '{}' ;;
  pipe) name=$1; ok_name "$name"; shift; exec $VS "$ROOT/$name/v.sock" 5000 pipe "$@" ;;
  run)  name=$1; ok_name "$name"; exec $VS "$ROOT/$name/v.sock" 5000 run "$2" "$3" "${4:-}" ;;
  prune) name=$1; ok_name "$name"; exec $VS "$ROOT/$name/v.sock" 5000 run - "$(printf 'python3\0-I\0/usr/local/bin/bp-prune.py\0/work/src\0/work/.bp/list' | base64 -w0)" "" ;;
  secret)
    # The attested sandbox sent its attestation document (with its fresh public key) to port 5005; KMS answers encrypted to that key, which only the
    # sandbox holds, and only if the document matches the key policy (PCR0: the image). This parent relays bytes and never sees the secret.
    name=$1 blob=$2 key=$3; ok_name "$name"; d=$ROOT/$name; t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
    timeout 120 socat -u "UNIX-LISTEN:$d/v.sock_5005" "CREATE:$t/att.bin" || die "no attestation document from $name"
    aws kms decrypt --key-id "$key" --ciphertext-blob "fileb://$blob" --recipient "KeyEncryptionAlgorithm=RSAES_OAEP_SHA_256,AttestationDocument@=fileb://$t/att.bin" \
      --query CiphertextForRecipient --output text | base64 -d > "$t/r.cms" || die "KMS refused (the image does not match the key policy?)"
    timeout 120 socat -u "OPEN:$t/r.cms" "UNIX-LISTEN:$d/v.sock_5006" || die "$name did not take the answer"; echo '{}' ;;
  *) sed -n '2,15p' "$0"; exit 2 ;;
esac
