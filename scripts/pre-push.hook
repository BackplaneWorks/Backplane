#!/bin/sh
# pre-push hook, installed by scripts/install-hooks.sh into <common .git>/hooks/, which serves every worktree.
# Refuses a push of commits (not yet on any remote) with an unapproved author or committer.
z=0000000000000000000000000000000000000000
chk=$(git rev-parse --git-common-dir)/hooks/check-author.sh
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  "$chk" "$lsha" --not --remotes || exit 1
done
exit 0
