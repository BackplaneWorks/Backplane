#!/bin/sh
# Use for direct Bend, Bun and browser E2E commands outside the build scripts.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
[ "$#" -gt 0 ] || { echo 'usage: scripts/heavy COMMAND [ARG ...]' >&2; exit 2; }
case "$(basename "$1")" in
  bend) case " $* " in *' PROOF.bend '*|*'/PROOF.bend '*) profile=proof ;; *) profile=check ;; esac ;;
  bun) case " ${2:-} " in ' build ') profile=build ;; *) profile=test ;; esac ;;
  *) profile=browser ;;
esac
exec python3 "$root/scripts/heavy-guard.py" "$profile" -- "$@"
