#!/bin/sh
# reference-transaction hook, installed by scripts/install-hooks.sh into <common .git>/hooks/, which serves every worktree.
# When refs/heads/main moves, make sure the main builder is running: it builds the new tip (tests, hub, window) and publishes it for the app to relaunch on.
# It blocks moves of the retired branches gpui and gpui-next ("use main"), and a move of main to commits whose author or committer is not build@amemb.com (scripts/check-author.sh); everything else exits 0.
if [ "$1" = prepared ]; then
  z=0000000000000000000000000000000000000000; bad=; badmain=
  root=$(git worktree list --porcelain 2>/dev/null | awk 'NR==1{print substr($0,10)}'); chk=$root/scripts/check-author.sh
  while read -r old new ref; do
    if [ "$ref" = refs/heads/main ] && [ "$new" != "$z" ] && [ "$old" != "$z" ] && [ -x "$chk" ]; then "$chk" "$new" --not "$old" || badmain=1; fi
    case "$ref" in refs/heads/gpui|refs/heads/gpui-next) [ "$new" = "$z" ] || [ "$new" = "$old" ] || bad="$ref" ;; esac
  done
  [ -z "$bad" ] || { echo "refused: ${bad#refs/heads/} is retired; use main (commit on your own branch from origin/main, merge to main)" >&2; exit 1; }
  [ -z "$badmain" ] || exit 1
  exit 0
fi
[ "$1" = committed ] || { cat > /dev/null; exit 0; }
hit=
while read -r old new ref; do [ "$ref" = refs/heads/main ] && hit=1; done
[ -n "$hit" ] || exit 0
root=$(git worktree list --porcelain 2>/dev/null | awk 'NR==1{print substr($0,10)}')
# the builder reads main from the refs, but its script is the one in the checkout it starts from: the main checkout's working tree can be far behind main
# (a stale main-build.sh there runs its own old dev-build.sh, and published builds without the embedded browser), so it starts from the builder's own checkout,
# which main-build.sh keeps at the last tip it built (and it re-runs itself from each tip it checks out); the main checkout only when there is none yet
s=$root/scripts/main-build.sh
for wt in "${MAIN_WT:-}" "$root/.backplane/worktrees/main-build"; do [ -n "$wt" ] && [ -x "$wt/scripts/main-build.sh" ] && { s=$wt/scripts/main-build.sh; break; }; done
[ -x "$s" ] && "$s" ensure > /dev/null 2>&1
exit 0
