#!/bin/bash
# cargo-q ARGS...: `cargo ARGS...` queued behind the machine-wide build slots (scripts/lib-buildslot.sh), through the shared compiler cache, with -j sized from free memory.
#   scripts/cargo-q test --offline          from native/host or native/gpui, in your own worktree, instead of bare cargo
# Every lane runs its tests and builds this way, so a few heavy builds run at once and the rest wait; the wait is said on stderr. An explicit -j/--jobs is kept.
HERE=$(cd "$(dirname "$0")" && pwd); . "$HERE/lib-buildslot.sh"
if [ -z "${BQ_HELD:-}" ]; then export BQ_HELD=1; waiting() { echo "cargo-q: waiting for a build slot" >&2; }; bq_run waiting "$0" "$@"; exit $?; fi
bq_cc
bp_notmp_target "${CARGO_TARGET_DIR:-}" || exit 1
j=(); case " $* " in *" -j"*|*" --jobs"*) ;; *) j=(-j "$(bq_jobs)");; esac
# The slot lock is fd 9 of THIS shell, which stays and waits: cargo and everything it starts (a test's stand-in `sleep`) run with fd 9 closed, so no orphan keeps a slot after the build ends.
# `test` also gets its own TMPDIR (the tests leak temp dirs made with std::env::temp_dir()), removed when it ends; kept, bounded, when it failed (lib-buildslot.sh bpt_new).
# `cargo xwin build ...` (the Windows -msvc cross-build, scripts/windows-check.sh): -j goes after the second word
n=1; [ "$1" = xwin ] && n=2
t=; [ "${!n}" = test ] && { t=$(bpt_new) || exit 1; }; pid=
stop() { trap - EXIT INT TERM HUP; [ -n "$pid" ] && { kill -TERM "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; }; bpt_rm "$t"; exit "$1"; }
trap 'stop 130' INT; trap 'stop 143' TERM HUP; trap 'stop 1' EXIT
# (a background job starts with SIGINT ignored; the subshell puts it back so ^C still stops cargo)
( trap - INT; [ -z "$t" ] || export TMPDIR=$t; exec nice -n 10 cargo "${@:1:n}" "${j[@]}" "${@:n+1}" <&0 9>&- ) & pid=$!
wait "$pid"; rc=$?; pid=; trap - EXIT INT TERM HUP; bpt_end "$t" "$rc"; exit "$rc"
